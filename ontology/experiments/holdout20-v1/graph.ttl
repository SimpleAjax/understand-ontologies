    ct:description "7.5  After termination  of  this  contract,  there  shall  be  a  sell-off           period  (defined  in  APPENDIX 2) following the date of termination of           this  contract." ;
    ct:kind "POST_EXPIRY_CONTINUATION" ;
    ct:qualifies ex:H01R01 ;
