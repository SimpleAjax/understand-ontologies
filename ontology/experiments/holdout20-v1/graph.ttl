ex:H01R02 a ct:Rule ;
    rdfs:label "Material or prospective breach cancellation" ;
    ct:description """7.2  Either  Party  shall  be  entitled  to  cancel  this  Agreement if the           other Party is materially in breach of the terms of this Agreement. If           the  breach  of  contract is capable of being remedied, this Agreement           can  be  cancelled  only  provided  that  the  Party in breach has not           rectified  its breach within thirty (30) days of the written notice by           the  other  Party.

     7.3  Either  Party  may  cancel  this  Agreement  already prior to the date           of  its  fulfillment,  if it becomes evident that the other Party will           commit  a  breach  of  contract  entitling  to  cancellation  of  this           Agreement.""" ;
    ct:kind "TERMINATION" ;
    ct:qualifies ex:H01R01 ;
    ct:subject_to ex:H01R02C ;
    ct:supported_by ex:H01R02P .

ex:H01R02C a ct:Condition ;
    rdfs:label "Remediable breach requires failure to rectify within 30 days of written notice; clause 7.3 covers evident prospective breach." ;
    ct:description "Remediable breach requires failure to rectify within 30 days of written notice; clause 7.3 covers evident prospective breach." ;
    ct:supported_by ex:H01R02P .

