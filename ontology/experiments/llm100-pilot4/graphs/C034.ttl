ex:C034P0018 a ct:SourcePassage ;
    ct:end_char 13110 ;
    ct:exact_text "The Production Fund Commitment shall be calculated monthly during the Term and shall be deducted as set out in Section 6 (b).   -5-" ;
    ct:source_path "cuad/EuromediaHoldingsCorp_20070215_10SB12G_EX-10.B(01)_525118_EX-10.B(01)_Content License Agreement.txt" ;
