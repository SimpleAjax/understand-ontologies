    ct:supported_by ex:C077P0008 ;
    meta:review_status "UNREVIEWED" .

ex:C077R0003 a ct:Rule ;
    rdfs:label "Termination — source passage 8" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C077R0003Condition8 ;
    ct:supported_by ex:C077P0008 ;
    meta:review_status "UNREVIEWED" .

