ex:C005R0005 a ct:Rule ;
    rdfs:label "Initial Term — source passage 38" ;
    ct:kind "INITIAL_TERM" ;
    ct:references_section ex:C005R0005Ref0,
        ex:C005R0005Ref1 ;
    ct:subject_to ex:C005R0005Condition38 ;
    ct:supported_by ex:C005P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C005R0005Condition38 a ct:Condition ;
    ct:description "(a) This Agreement is effective as of the date hereof and shall remain in full force and effect for the period (the \"Covered Period\") commencing on the date hereof and ending on the date that is the earliest of: (i) the Company's failure to appoint the ValueAct Designee to the Board following the ValueAct Group's written request to the Company to have the ValueAct Designee appointed to the Board pursuant to Section 1(a) of this Agreement; (ii) the failure of the Company to comply in good faith with Section 1(e) of this Agreement; or (iii) the date which is the 60t h day prior to the Company's 2016 annual meeting of stockholders." ;
    ct:supported_by ex:C005P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C005R0005Ref0 a ct:Reference ;
    rdfs:label "Section 1(a)" ;
    ct:resolution_status "UNRESOLVED" .

ex:C005R0005Ref1 a ct:Reference ;
    rdfs:label "Section 1(e)" ;
    ct:resolution_status "UNRESOLVED" .

