    rdfs:label "Automatic Renewal — source passage 40" ;
    ct:kind "AUTOMATIC_RENEWAL" ;
    ct:subject_to ex:C028R0005Condition40 ;
    ct:supported_by ex:C028P0040 ;
    meta:review_status "UNREVIEWED" .

