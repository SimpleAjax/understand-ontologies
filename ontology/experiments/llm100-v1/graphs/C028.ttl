ex:C028P0014 a ct:SourcePassage ;
    ct:end_char 2036 ;
    ct:exact_text "2.3  LICENSOR  grants  plan_b  for  the  term  of  this Agreement the right           to  produce,  market  and  distribute  Content  to  End  Users (in the           territory  specified  in appendix 2) through its own and its partner's           platform." ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 1779 .

ex:C028P0036 a ct:SourcePassage ;
    ct:end_char 7007 ;
    ct:exact_text "6.2  Each Party  shall  promptly  upon  termination  of  this  Agreement or           when the Party no longer needs the material or information in question           for  the  purpose  stated  in  this Agreement cease using confidential           material and information received from the other Party and, unless the           Parties  separately  agree on destruction of such material, return the           material  in  question  (including  all  copies  thereof)." ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 6539 .

ex:C028P0037 a ct:SourcePassage ;
    ct:end_char 7170 ;
    ct:exact_text "6.3  The rights  and  responsibilities  under  this  section  shall survive           any  termination  or  cancellation  of  this  Agreement  for  2 years." ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 7014 .

ex:C028P0043 a ct:SourcePassage ;
    ct:end_char 8733 ;
    ct:exact_text "7.4  Upon termination  or  cancellation  of  this  Agreement  plan_b  shall           cease to use Content for any purpose and delete Content from any files           and  data  storage." ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 8547 .

ex:C028P0044 a ct:SourcePassage ;
    ct:end_char 8921 ;
    ct:exact_text "7.5  After termination  of  this  contract,  there  shall  be  a  sell-off           period  (defined  in  APPENDIX 2) following the date of termination of           this  contract." ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 8740 .

ex:C028P0095 a ct:SourcePassage ;
    ct:end_char 13692 ;
    ct:exact_text "2.1  Contract  start:  04-01-06" ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 13661 .

ex:C028P0096 a ct:SourcePassage ;
    ct:end_char 13728 ;
    ct:exact_text "2.2  Contract  end:  04-01-08" ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
    ct:start_char 13699 .

ex:C028P0098 a ct:SourcePassage ;
    ct:end_char 13841 ;
    ct:exact_text "2.4  Sell-off  period:  3  months  after  termination" ;
    ct:source_path "cuad/DataCallTechnologies_20060918_SB-2A_EX-10.9_944510_EX-10.9_Content License Agreement.txt" ;
    ct:source_sha256 "20f0f1630d8ae7ba221fbbf9d0449a593605989dfa3c779cafdb9c233bb6ebe7" ;
