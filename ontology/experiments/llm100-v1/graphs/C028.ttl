ex:C028R0006Condition41 a ct:Condition ;
    ct:description "7.2  Either  Party  shall  be  entitled  to  cancel  this  Agreement if the           other Party is materially in breach of the terms of this Agreement. If           the  breach  of  contract is capable of being remedied, this Agreement           can  be  cancelled  only  provided  that  the  Party in breach has not           rectified  its breach within thirty (30) days of the written notice by           the  other  Party." ;
    ct:supported_by ex:C028P0041 ;
    meta:review_status "UNREVIEWED" .

