    ct:description "a. Term. This Agreement  shall become  effective on the Effective Date      and shall  continue in effect until  either  Party  informs the other Party      with thirty (30) day prior written notice of termination of this Agreement." ;
    ct:supported_by ex:C087P0026 ;
    meta:review_status "UNREVIEWED" .

