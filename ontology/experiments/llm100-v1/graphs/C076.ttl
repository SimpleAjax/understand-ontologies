    rdfs:label "Conditional Referenced Term — source passage 26" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:references_section ex:C076R0002Ref0 ;
    ct:subject_to ex:C076R0002Condition26 ;
