ex:C066P0040 a ct:SourcePassage ;
    ct:end_char 10444 ;
    ct:exact_text "EFFECT OF TERMINATION: Any termination shall be without any liability or obligation of the terminating party, other than with respect to any breach of this Agreement prior to termination. The provisions relating to property rights and confidentiality shall survive any termination or expiration of this Agreement. All revenue sharing ceases with the termination of this Agreement." ;
