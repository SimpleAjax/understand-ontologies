ex:C066P0026 a ct:SourcePassage ;
    ct:end_char 6623 ;
    ct:exact_text "PERFORMANCE: In lieu of PACIFICAP ENTERTAINMENT granting a 10 year Exclusive Content License to THE HENRY FILM AND ENTERTAINMENT CORPORATION, THE HENRY FILM AND ENTERTAINMENT CORPORATION agrees to share a minimum of $50,000.00 annually for each year of this Agreement. In the event of THE HENRY FILM AND ENTERTAINMENT CORPORATION, not fulfilling this minimum PERFORMANCE, PACIFICAP ENTERTAINMENT may cancel this Agreement" ;
    ct:source_path "cuad/PacificapEntertainmentHoldingsInc_20051115_8-KA_EX-1.01_4300894_EX-1.01_Content License Agreement.txt" ;
    ct:source_sha256 "167674d1478745bdbd7be6c3195f3e0eb3e7d741dfa6ad27c56ab4152f2a9a62" ;
    ct:start_char 6202 .

ex:C066R0001 a ct:Rule ;
    rdfs:label "Termination — source passage 26" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C066P0026 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0002 a ct:Rule ;
    rdfs:label "Initial Term — source passage 38" ;
    ct:kind "INITIAL_TERM" ;
    ct:subject_to ex:C066R0002Condition38 ;
    ct:supported_by ex:C066P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0002Condition38 a ct:Condition ;
    ct:description "INITIAL TERM AND RENEWALS: This Agreement will become effective as of the last date of signature (Effective Date) and shall, unless sooner terminated as provided below or as otherwise agreed, remain effective for an initial term of 10 Years following the first date of public availability of the PACIFICAP ENTERTAINMENT Content within a THE HENRY FILM AND ENTERTAINMENT CORPORATION Property (the \"Initial Term\"). After the Initial Term, this Agreement will be automatically renewed for successive additional 3~year periods (\"Extension Terms\"), unless otherwise terminated by either party by giving notice to the other party not less than sixty (60) days prior to the end of a Term. As used herein, the \"Term\" means the Initial Term and any Extension Term(s)." ;
    ct:supported_by ex:C066P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0003 a ct:Rule ;
    rdfs:label "Automatic Renewal — source passage 38" ;
    ct:kind "AUTOMATIC_RENEWAL" ;
    ct:subject_to ex:C066R0003Condition38 ;
    ct:supported_by ex:C066P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0003Condition38 a ct:Condition ;
    ct:description "INITIAL TERM AND RENEWALS: This Agreement will become effective as of the last date of signature (Effective Date) and shall, unless sooner terminated as provided below or as otherwise agreed, remain effective for an initial term of 10 Years following the first date of public availability of the PACIFICAP ENTERTAINMENT Content within a THE HENRY FILM AND ENTERTAINMENT CORPORATION Property (the \"Initial Term\"). After the Initial Term, this Agreement will be automatically renewed for successive additional 3~year periods (\"Extension Terms\"), unless otherwise terminated by either party by giving notice to the other party not less than sixty (60) days prior to the end of a Term. As used herein, the \"Term\" means the Initial Term and any Extension Term(s)." ;
    ct:supported_by ex:C066P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0004 a ct:Rule ;
    rdfs:label "Termination — source passage 39" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C066R0004Condition39 ;
    ct:supported_by ex:C066P0039 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0004Condition39 a ct:Condition ;
    ct:description "TERMINATION FOR CAUSE: Notwithstanding the foregoing, this Agreement may be terminated by either party immediately upon notice if the other party: (w) becomes insolvent; (x) files a petition in bankruptcy; (y) makes an assignment for the benefit of its creditors; or (z) breach any of its obligations under this Agreement in any material respect, which breach is not remedied within thirty (30) days following written notice to such party." ;
    ct:supported_by ex:C066P0039 ;
    meta:review_status "UNREVIEWED" .

ex:C066R0005 a ct:Rule ;
    rdfs:label "Termination — source passage 40" ;
