        ex:C016R0008 ;
    ct:source_path "cuad/BLACKBOXSTOCKSINC_08_05_2014-EX-10.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "0d2edecafe20a5de97f47ed19b08e2df988b3471e3da810944017ec8675adba5" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C016P0013 a ct:SourcePassage ;
    ct:end_char 4470 ;
    ct:exact_text "3.03.  Cancellation. Distributor may, at any time prior to the scheduled date of shipment, cancel any or all Products on order upon giving timely written notice." ;
    ct:source_path "cuad/BLACKBOXSTOCKSINC_08_05_2014-EX-10.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "0d2edecafe20a5de97f47ed19b08e2df988b3471e3da810944017ec8675adba5" ;
    ct:start_char 4309 .

ex:C016P0021 a ct:SourcePassage ;
    ct:end_char 8004 ;
    ct:exact_text "6.02.  Termination. This Agreement may be terminated only:" ;
    ct:source_path "cuad/BLACKBOXSTOCKSINC_08_05_2014-EX-10.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "0d2edecafe20a5de97f47ed19b08e2df988b3471e3da810944017ec8675adba5" ;
    ct:start_char 7946 .

ex:C016P0022 a ct:SourcePassage ;
    ct:end_char 8253 ;
    ct:exact_text "(a)  By either party for substantial breach of any material provision of this Agreement by the other, provided due notice has been given to the other of the alleged breach and such other party has not cured the breach within (30) days] thereof; or" ;
    ct:source_path "cuad/BLACKBOXSTOCKSINC_08_05_2014-EX-10.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "0d2edecafe20a5de97f47ed19b08e2df988b3471e3da810944017ec8675adba5" ;
    ct:start_char 8006 .

ex:C016P0024 a ct:SourcePassage ;
    ct:end_char 9190 ;
    ct:exact_text "(d)  Upon termination of this Agreement all further rights and obligations of the parties shall cease, except that Distributor shall not be relieved of (i) its obligation to pay any monies due, or to become due, as of or after the date of termination, and (ii) any other obligation set forth in this Agreement which is to take effect after the date of termination." ;
    ct:source_path "cuad/BLACKBOXSTOCKSINC_08_05_2014-EX-10.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "0d2edecafe20a5de97f47ed19b08e2df988b3471e3da810944017ec8675adba5" ;
    ct:start_char 8826 .

