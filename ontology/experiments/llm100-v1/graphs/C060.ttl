    ct:subject_to ex:C060R0005Condition81 ;
    ct:supported_by ex:C060P0081 ;
    meta:review_status "UNREVIEWED" .

ex:C060R0005Condition81 a ct:Condition ;
    ct:description "In relation to each Fund, this Agreement shall terminate on the earlier of (a) the expiration of the term of such Fund or (b) the date, if any, on which Oaktree US (or any affiliate it has substituted in its stead in accordance with such Fund's Fund Agreement) is removed as general partner of such Fund or (c) the Sub-Advisor ceasing to be authorised and regulated by the FCA." ;
    ct:supported_by ex:C060P0081 ;
    meta:review_status "UNREVIEWED" .

