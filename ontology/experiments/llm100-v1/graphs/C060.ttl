ex:C060 a ct:Agreement ;
    rdfs:label "OAKTREECAPITALGROUP,LLC_03_02_2020-EX-10.8-Services Agreement.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C060R0001,
        ex:C060R0002,
