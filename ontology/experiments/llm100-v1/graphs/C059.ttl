ct: a owl:Ontology ;
    rdfs:comment "Partial five-contract development sample. No claim of complete contract coverage or legal correctness." .

ct:agreement_effective_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:applies_within a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:calendar_date_status a owl:DatatypeProperty .

ct:coverage a owl:DatatypeProperty .

ct:description a owl:DatatypeProperty .

ct:duration a owl:DatatypeProperty .

ct:duration_status a owl:DatatypeProperty .

ct:end_char a owl:DatatypeProperty .

ct:end_date_status a owl:DatatypeProperty .

ct:ends_on_event a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:exact_text a owl:DatatypeProperty .

ct:has_party a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Party .

ct:has_rule a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Rule .

ct:kind a owl:DatatypeProperty .

ct:notice_actor a owl:DatatypeProperty .

ct:notice_form a owl:DatatypeProperty .

ct:notice_period_status a owl:DatatypeProperty .

ct:qualifies a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Rule .

ct:references_section a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:renewal_count a owl:DatatypeProperty .

ct:resolution_status a owl:DatatypeProperty .

ct:resolved_to a owl:ObjectProperty ;
    rdfs:domain ct:Reference ;
    rdfs:range ct:SourcePassage .

ct:source_path a owl:DatatypeProperty .

ct:source_sha256 a owl:DatatypeProperty .

ct:start_char a owl:DatatypeProperty .

ct:starts_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:stated_end_date a owl:DatatypeProperty .

ct:subject_to a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Condition .

ct:supported_by a owl:ObjectProperty ;
    rdfs:range ct:SourcePassage .

ct:termination_notice a owl:DatatypeProperty .

ex:C059 a ct:Agreement ;
    rdfs:label "NOVOINTEGRATEDSCIENCES,INC_12_23_2019-EX-10.1-JOINT VENTURE AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C059R0001,
        ex:C059R0002 ;
    ct:source_path "cuad/NOVOINTEGRATEDSCIENCES,INC_12_23_2019-EX-10.1-JOINT VENTURE AGREEMENT.txt" ;
    ct:source_sha256 "ed8ec45674420e7e9d118f9141a3d0ad67b283c76ff1e2a703d339f731d65c2b" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C059R0001 a ct:Rule ;
    rdfs:label "Initial Term — source passage 11" ;
    ct:kind "INITIAL_TERM" ;
    ct:references_section ex:C059R0001Ref0,
        ex:C059R0001Ref1,
        ex:C059R0001Ref2 ;
    ct:subject_to ex:C059R0001Condition11 ;
    ct:supported_by ex:C059P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C059R0001Condition11 a ct:Condition ;
    ct:description "6.2 Upon execution of the proposal, HGF will provide necessary documentation (allocated land) required for the completion of the construction and management package. 6.3 Harvesting schedule occurs as dictated by determined cash crop selection. Accompanying cash flow projections will be completed upon binding buyer contract receipt. ARTICLE 7 - PRINCIPLE AND LINE OF CREDIT RETURNS 7.1 Priority is given to all debt service requirements with principle pay-back schedule adherence based on cash flow actual conditions. Distribution to Parties as per agreement on a \"last to issue\" basis. ARTICLE 8 - TERM OF AGREEMENT 8.1 The initial term of this Agreement shall, unless sooner terminated by consent of all parties, expires in five (5) years from the date of Effective Date. NVOS and HGF may renew the Agreement within two (2) years of the expiry of the initial term upon mutual understanding. 8.2 It is understood that a subsequent renewal of a five (5) year term will be negotiated in good faith and shall carry terms very close to the original Agreement. 8.3 Both parties may enter into buyout negotiations with the other Party on terms agreeable to both Parties. ARTICLE 9 - OBLIGATIONS OF NVOS 9.1 To maintain all financial records of the Company and provide quarterly and annual reporting to all Company stakeholders. All records are kept under US GAAP compliance standards. " ;
    ct:supported_by ex:C059P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C059R0001Ref0 a ct:Reference ;
    rdfs:label "ARTICLE 7" ;
    ct:resolution_status "UNRESOLVED" .

ex:C059R0001Ref1 a ct:Reference ;
    rdfs:label "ARTICLE 8" ;
    ct:resolution_status "UNRESOLVED" .

ex:C059R0001Ref2 a ct:Reference ;
    rdfs:label "ARTICLE 9" ;
    ct:resolution_status "UNRESOLVED" .

ex:C059R0002 a ct:Rule ;
    rdfs:label "Optional Renewal — source passage 11" ;
    ct:kind "OPTIONAL_RENEWAL" ;
    ct:references_section ex:C059R0002Ref0,
        ex:C059R0002Ref1,
        ex:C059R0002Ref2 ;
    ct:subject_to ex:C059R0002Condition11 ;
    ct:supported_by ex:C059P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C059R0002Condition11 a ct:Condition ;
    ct:description "6.2 Upon execution of the proposal, HGF will provide necessary documentation (allocated land) required for the completion of the construction and management package. 6.3 Harvesting schedule occurs as dictated by determined cash crop selection. Accompanying cash flow projections will be completed upon binding buyer contract receipt. ARTICLE 7 - PRINCIPLE AND LINE OF CREDIT RETURNS 7.1 Priority is given to all debt service requirements with principle pay-back schedule adherence based on cash flow actual conditions. Distribution to Parties as per agreement on a \"last to issue\" basis. ARTICLE 8 - TERM OF AGREEMENT 8.1 The initial term of this Agreement shall, unless sooner terminated by consent of all parties, expires in five (5) years from the date of Effective Date. NVOS and HGF may renew the Agreement within two (2) years of the expiry of the initial term upon mutual understanding. 8.2 It is understood that a subsequent renewal of a five (5) year term will be negotiated in good faith and shall carry terms very close to the original Agreement. 8.3 Both parties may enter into buyout negotiations with the other Party on terms agreeable to both Parties. ARTICLE 9 - OBLIGATIONS OF NVOS 9.1 To maintain all financial records of the Company and provide quarterly and annual reporting to all Company stakeholders. All records are kept under US GAAP compliance standards. " ;
    ct:supported_by ex:C059P0011 ;
    meta:review_status "UNREVIEWED" .

