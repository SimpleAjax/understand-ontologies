ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C057P0003 a ct:SourcePassage ;
    ct:end_char 255 ;
    ct:exact_text "THIS AGREEMENT, made as of the 1st day of December, (the \"Effective Date\") by and between:" ;
    ct:source_path "cuad/NEOMEDIATECHNOLOGIESINC_12_15_2005-EX-16.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "b3db6d72f9b7e01afbc4f535c2c4475bdbe758225567ea89ac2b3105276d6993" ;
    ct:start_char 165 .

ex:C057P0101 a ct:SourcePassage ;
    ct:end_char 25895 ;
    ct:exact_text "Notwithstanding the provisions of any law, rule, or regulation to the contrary, on the termination of this Agreement for any cause whatsoever, DISTRIBUTOR shall not be entitled to claim or receive from PPG SHANGHAI any compensation, reimbursement, or damages on account of any expenditure or commitment of any kind in connection with its business or on account of goodwill or on account of loss of prospective profits or otherwise. In no event shall PPG SHANGHAI be liable for consequential damages." ;
    ct:source_path "cuad/NEOMEDIATECHNOLOGIESINC_12_15_2005-EX-16.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "b3db6d72f9b7e01afbc4f535c2c4475bdbe758225567ea89ac2b3105276d6993" ;
    ct:start_char 25396 .

ex:C057P0109 a ct:SourcePassage ;
    ct:end_char 28710 ;
    ct:exact_text "18.1     The term of this Agreement (the \"Term\") shall commence on the date          first above written and shall terminate on 31 December 2006, unless          sooner terminated in accordance with the provisions hereof." ;
    ct:source_path "cuad/NEOMEDIATECHNOLOGIESINC_12_15_2005-EX-16.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "b3db6d72f9b7e01afbc4f535c2c4475bdbe758225567ea89ac2b3105276d6993" ;
    ct:start_char 28489 .

ex:C057P0112 a ct:SourcePassage ;
    ct:end_char 29989 ;
    ct:exact_text "19.      DEFAULT AND TERMINATION" ;
    ct:source_path "cuad/NEOMEDIATECHNOLOGIESINC_12_15_2005-EX-16.1-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "b3db6d72f9b7e01afbc4f535c2c4475bdbe758225567ea89ac2b3105276d6993" ;
    ct:start_char 29957 .

