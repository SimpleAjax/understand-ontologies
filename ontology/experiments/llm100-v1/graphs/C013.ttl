ex:C013P0054 a ct:SourcePassage ;
    ct:end_char 21866 ;
    ct:exact_text "Supplier that creates an immediate public food safety risk, PNC may terminate this Agreement immediately without regard to any period for correction." ;
    ct:source_path "cuad/BELLRINGBRANDS,INC_02_07_2020-EX-10.18-MASTER SUPPLY AGREEMENT.txt" ;
    ct:source_sha256 "4db35cae428d32e800d78491fbda9306df3b93ae8bb5c4c48a899e4943eb21d8" ;
    ct:start_char 21717 .

ex:C013P0056 a ct:SourcePassage ;
    ct:end_char 22579 ;
    ct:exact_text "6.4 On the termination of this Agreement for any reason, all rights granted to Supplier under this Agreement will immediately cease, and Supplier must deliver to PNC all written or recorded materials relating to the Confidential Information of PNC in the possession or control of Supplier or any of its related party, subject to Section 5.2." ;
    ct:source_path "cuad/BELLRINGBRANDS,INC_02_07_2020-EX-10.18-MASTER SUPPLY AGREEMENT.txt" ;
    ct:source_sha256 "4db35cae428d32e800d78491fbda9306df3b93ae8bb5c4c48a899e4943eb21d8" ;
    ct:start_char 22238 .

ex:C013R0001 a ct:Rule ;
    rdfs:label "Termination — source passage 29" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C013R0001Condition29 ;
    ct:supported_by ex:C013P0029 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0001Condition29 a ct:Condition ;
    ct:description "2.5 Subject to the occurring of a Force Majeure Event, if Supplier fails to deliver the Ingredients in accordance with the Specifications, including within the time specified on the Purchase Order, in addition to any other remedies available, PNC may terminate the Purchase Order in whole or in part. In the event of such a termination, Supplier shall continue performance of any nonterminated portion of the Purchase Order, or any nonterminated Purchase Orders, and the quantity of Ingredient ordered and so terminated shall be deducted against any relevant Master Purchase Commitment." ;
    ct:supported_by ex:C013P0029 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0002 a ct:Rule ;
    rdfs:label "Post Expiry Continuation — source passage 29" ;
    ct:kind "POST_EXPIRY_CONTINUATION" ;
    ct:subject_to ex:C013R0002Condition29 ;
    ct:supported_by ex:C013P0029 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0002Condition29 a ct:Condition ;
    ct:description "2.5 Subject to the occurring of a Force Majeure Event, if Supplier fails to deliver the Ingredients in accordance with the Specifications, including within the time specified on the Purchase Order, in addition to any other remedies available, PNC may terminate the Purchase Order in whole or in part. In the event of such a termination, Supplier shall continue performance of any nonterminated portion of the Purchase Order, or any nonterminated Purchase Orders, and the quantity of Ingredient ordered and so terminated shall be deducted against any relevant Master Purchase Commitment." ;
    ct:supported_by ex:C013P0029 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0003 a ct:Rule ;
    rdfs:label "Termination — source passage 33" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C013R0003Condition33 ;
    ct:supported_by ex:C013P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0003Condition33 a ct:Condition ;
    ct:description "In the event of an actual or suspected food safety concern, Supplier shall conduct sampling in all relevant areas and promptly provide results of such tests to PNC. If PNC or its representatives find that any of Supplier's facilities, processes, inventory, procedures or equipment are not in accordance or compliance with the requirements of this Agreement or applicable law or regulation, PNC will give notice to Supplier, and Supplier shall promptly take all reasonable steps to correct such deficiency as soon as possible. If correction of the deficiency cannot be affected within [***] of such notice, then Supplier shall promptly notify PNC with its plan to correct the deficiency including an estimated schedule. If the deficiency cannot be corrected within [***], unless otherwise agreed, then PNC shall have the right to terminate any Purchase Orders then outstanding, along with any Master Purchase Commitment related thereto." ;
    ct:supported_by ex:C013P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0004 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 33" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C013R0004Condition33 ;
    ct:supported_by ex:C013P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0004Condition33 a ct:Condition ;
    ct:description "In the event of an actual or suspected food safety concern, Supplier shall conduct sampling in all relevant areas and promptly provide results of such tests to PNC. If PNC or its representatives find that any of Supplier's facilities, processes, inventory, procedures or equipment are not in accordance or compliance with the requirements of this Agreement or applicable law or regulation, PNC will give notice to Supplier, and Supplier shall promptly take all reasonable steps to correct such deficiency as soon as possible. If correction of the deficiency cannot be affected within [***] of such notice, then Supplier shall promptly notify PNC with its plan to correct the deficiency including an estimated schedule. If the deficiency cannot be corrected within [***], unless otherwise agreed, then PNC shall have the right to terminate any Purchase Orders then outstanding, along with any Master Purchase Commitment related thereto." ;
    ct:supported_by ex:C013P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0005 a ct:Rule ;
