    meta:review_status "UNREVIEWED" .

ex:C013R0007Condition52 a ct:Condition ;
    ct:description "6.2 Either Party may terminate this Agreement for cause if the other Party fails to perform any material provision of this Agreement or commits a material breach of this Agreement which is not corrected within [***] after receiving written notice of the failure or breach. except that if the default is by" ;
    ct:supported_by ex:C013P0052 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0008 a ct:Rule ;
    rdfs:label "Termination — source passage 54" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C013P0054 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0009 a ct:Rule ;
    rdfs:label "Termination — source passage 55" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C013R0009Condition55 ;
    ct:supported_by ex:C013P0055 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0009Condition55 a ct:Condition ;
    ct:description "6.3 This Agreement will automatically terminate if either Party becomes insolvent or files a petition in bankruptcy, if a Party makes an assignment for the benefit of a creditor, if a receiver is appointed to take possession of any part of a Party's assets or if a Party becomes unable generally to pay its debts as they become due, or otherwise ceases to do business." ;
    ct:supported_by ex:C013P0055 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0010 a ct:Rule ;
    rdfs:label "Termination — source passage 56" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C013R0010Ref0 ;
    ct:supported_by ex:C013P0056 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0010Ref0 a ct:Reference ;
