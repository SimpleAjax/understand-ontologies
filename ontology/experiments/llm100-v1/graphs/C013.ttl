    ct:description "6.1 This Agreement will commence on the Effective Date and continue for an Initial Term of five (5) years, and will automatically renew for additional periods of five (5) years unless one Party notifies the other of its intention not to renew, no less than 12 months prior to the expiration of the then-current term, unless terminated as permitted under this Agreement." ;
    ct:supported_by ex:C013P0051 ;
    meta:review_status "UNREVIEWED" .

ex:C013R0007 a ct:Rule ;
