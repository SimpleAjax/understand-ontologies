    rdfs:label "Section 14.2.1" ;
    ct:resolution_status "UNRESOLVED" .

ex:C069R0010Ref1 a ct:Reference ;
    rdfs:label "Section 4.2.2(ii)" ;
    ct:resolution_status "UNRESOLVED" .

