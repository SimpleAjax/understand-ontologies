    rdfs:label "Termination — source passage 36" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C071R0001Ref0 ;
    ct:supported_by ex:C071P0036 ;
    meta:review_status "UNREVIEWED" .

ex:C071R0001Ref0 a ct:Reference ;
    rdfs:label "ARTICLE VI" ;
    ct:resolution_status "UNRESOLVED" .

ex:C071R0002 a ct:Rule ;
    rdfs:label "Termination — source passage 37" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C071R0002Ref0 ;
    ct:subject_to ex:C071R0002Condition37 ;
    ct:supported_by ex:C071P0037 ;
    meta:review_status "UNREVIEWED" .

ex:C071R0002Condition37 a ct:Condition ;
    ct:description "This Agreement may be terminated at any time while the Employee is living by written notice thereof by either the Employer or the Employee to the other; and, in any event, this Agreement will terminate upon termination of the Employee's employment. ARTICLE VII \"Plan Management\"" ;
    ct:supported_by ex:C071P0037 ;
    meta:review_status "UNREVIEWED" .

ex:C071R0002Ref0 a ct:Reference ;
    rdfs:label "ARTICLE VII" ;
    ct:resolution_status "UNRESOLVED" .

