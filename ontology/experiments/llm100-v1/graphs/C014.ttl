    ct:end_char 14933 ;
    ct:exact_text "6.   TERM AND TERMINATION." ;
    ct:source_path "cuad/BEYONDCOMCORP_08_03_2000-EX-10.2-CO-HOSTING AGREEMENT.txt" ;
