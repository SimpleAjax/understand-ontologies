ex:C014R0001Condition35 a ct:Condition ;
    ct:description "(c)  Use of Trademarks. Co-Host hereby grants to NAI a non-exclusive,           non-transferable, royalty-free license during the term of this           Agreement to use the trademarks, service marks and trade names of           Co-Host in connection with the advertising and promotion of the Goods           from the Originating Locations, provided that NAI complies with the           terms of Section 9(b) of the Web Site Services Agreement (as defined           below). Co-Host reserves the right to terminate the foregoing right,           after giving NAI notice and opportunity to cure the allegedly harmful           use, if in Co-Host's reasonable judgment, NAI's use of such           trademarks, service marks and trade names harms the business, image or           goodwill of Co-Host." ;
    ct:supported_by ex:C014P0035 ;
    meta:review_status "UNREVIEWED" .

ex:C014R0001Ref0 a ct:Reference ;
    rdfs:label "Section 9(b)" ;
    ct:resolution_status "UNRESOLVED" .

