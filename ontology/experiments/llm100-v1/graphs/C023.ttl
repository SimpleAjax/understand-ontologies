ex:C023P0392 a ct:SourcePassage ;
    ct:end_char 120025 ;
    ct:exact_text "(a) Licensee may terminate this Agreement immediately upon written notice sent to Bioeq any time between [***] and until the receipt of first Regulatory Approval of any Licensed Product in the Field in the Territory if (a) Bioeq has failed to obtain any Regulatory Approval for any Licensed Product in the Field in the Territory on or prior to [***], and (b) [***]." ;
