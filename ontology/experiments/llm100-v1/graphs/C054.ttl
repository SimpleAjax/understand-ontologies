ct: a owl:Ontology ;
    rdfs:comment "Partial five-contract development sample. No claim of complete contract coverage or legal correctness." .

ct:agreement_effective_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:applies_within a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:calendar_date_status a owl:DatatypeProperty .

ct:coverage a owl:DatatypeProperty .

ct:description a owl:DatatypeProperty .

ct:duration a owl:DatatypeProperty .

ct:duration_status a owl:DatatypeProperty .

ct:end_char a owl:DatatypeProperty .

ct:end_date_status a owl:DatatypeProperty .

ct:ends_on_event a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:exact_text a owl:DatatypeProperty .

ct:has_party a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Party .

ct:has_rule a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Rule .

ct:kind a owl:DatatypeProperty .

ct:notice_actor a owl:DatatypeProperty .

ct:notice_form a owl:DatatypeProperty .

ct:notice_period_status a owl:DatatypeProperty .

ct:qualifies a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Rule .

ct:references_section a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:renewal_count a owl:DatatypeProperty .

ct:resolution_status a owl:DatatypeProperty .

ct:resolved_to a owl:ObjectProperty ;
    rdfs:domain ct:Reference ;
    rdfs:range ct:SourcePassage .

ct:source_path a owl:DatatypeProperty .

ct:source_sha256 a owl:DatatypeProperty .

ct:start_char a owl:DatatypeProperty .

ct:starts_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:stated_end_date a owl:DatatypeProperty .

ct:subject_to a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Condition .

ct:supported_by a owl:ObjectProperty ;
    rdfs:range ct:SourcePassage .

ct:termination_notice a owl:DatatypeProperty .

ex:C054 a ct:Agreement ;
    rdfs:label "MEETGROUP,INC_06_29_2017-EX-10.1-COOPERATION AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C054R0001,
        ex:C054R0002 ;
    ct:source_path "cuad/MEETGROUP,INC_06_29_2017-EX-10.1-COOPERATION AGREEMENT.txt" ;
    ct:source_sha256 "7aa6582007f2f953ed7f0fdc4418025054183c37386162db7ae073249cbadaec" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C054R0001 a ct:Rule ;
    rdfs:label "Termination — source passage 27" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C054R0001Condition27 ;
    ct:supported_by ex:C054P0027 ;
    meta:review_status "UNREVIEWED" .

ex:C054R0001Condition27 a ct:Condition ;
    ct:description "the terms \"person\" or \"persons\" shall mean any individual, corporation (including not-for-profit), general or limited partnership, limited liability company, joint venture, estate, trust, association, organization or other entity of any kind or nature; and the term \"Related Person\" shall mean, as to any person, any Affiliates or Associates of such person.   (e) Notwithstanding anything contained in this Agreement to the contrary:   (i) The provisions of Sections 1, 2, and 3 of this Agreement shall automatically terminate upon the occurrence of a Change of Control transaction (as defined below) involving the Company if the acquiring or counter-party to the Change of Control transaction has conditioned the closing of the transaction on the termination of such sections; provided, however, that the Company shall not directly or indirectly, propose, seek, encourage or otherwise influence such acquiring or counter-party to the Change of Control transaction to condition the closing of such transaction on the termination of Sections 1, 2, and 3 of this Agreement; and     8" ;
    ct:supported_by ex:C054P0027 ;
    meta:review_status "UNREVIEWED" .

ex:C054R0002 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 27" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C054R0002Condition27 ;
    ct:supported_by ex:C054P0027 ;
    meta:review_status "UNREVIEWED" .

ex:C054R0002Condition27 a ct:Condition ;
    ct:description "the terms \"person\" or \"persons\" shall mean any individual, corporation (including not-for-profit), general or limited partnership, limited liability company, joint venture, estate, trust, association, organization or other entity of any kind or nature; and the term \"Related Person\" shall mean, as to any person, any Affiliates or Associates of such person.   (e) Notwithstanding anything contained in this Agreement to the contrary:   (i) The provisions of Sections 1, 2, and 3 of this Agreement shall automatically terminate upon the occurrence of a Change of Control transaction (as defined below) involving the Company if the acquiring or counter-party to the Change of Control transaction has conditioned the closing of the transaction on the termination of such sections; provided, however, that the Company shall not directly or indirectly, propose, seek, encourage or otherwise influence such acquiring or counter-party to the Change of Control transaction to condition the closing of such transaction on the termination of Sections 1, 2, and 3 of this Agreement; and     8" ;
    ct:supported_by ex:C054P0027 ;
    meta:review_status "UNREVIEWED" .

