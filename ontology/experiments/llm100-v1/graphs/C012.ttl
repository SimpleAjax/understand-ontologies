    rdfs:label "Optional Renewal — source passage 21" ;
    ct:kind "OPTIONAL_RENEWAL" ;
    ct:references_section ex:C012R0006Ref0 ;
    ct:subject_to ex:C012R0006Condition21 ;
    ct:supported_by ex:C012P0021 ;
    meta:review_status "UNREVIEWED" .

