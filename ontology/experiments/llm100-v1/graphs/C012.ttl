        ex:C012R0008,
        ex:C012R0009 ;
    ct:source_path "cuad/BANUESTRAFINANCIALCORP_09_08_2006-EX-10.16-AGENCY AGREEMENT.txt" ;
    ct:source_sha256 "8a409e55f61a647c258e02748912d68112b3a13fce72f17a060135157c73cd9c" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C012P0020 a ct:SourcePassage ;
    ct:end_char 6220 ;
    ct:exact_text "In the event the Offering is terminated and the Closing (as defined below) does not occur, then the Agent shall not receive the fees set forth in subparagraph (a) below (the \"Fees\"); provided, however, regardless of whether or not the Closing occurs, the Agent shall be entitled to receive reimbursement of its actual accountable out-of-pocket expenses, as set forth in subparagraph (b) below." ;
    ct:source_path "cuad/BANUESTRAFINANCIALCORP_09_08_2006-EX-10.16-AGENCY AGREEMENT.txt" ;
    ct:source_sha256 "8a409e55f61a647c258e02748912d68112b3a13fce72f17a060135157c73cd9c" ;
    ct:start_char 5827 .

ex:C012P0026 a ct:SourcePassage ;
    ct:end_char 8494 ;
    ct:exact_text "b. Agent shall be reimbursed for expenses as contemplated by Section 8 of this Agreement, regardless of whether the Offering is successfully completed. Any out-of-pocket expenses or commissions payable under this Agreement shall be paid in next day funds on the earlier of the initial Closing Date or a determination by the Company to terminate or abandon the Offering, and on each subsequent Closing Date thereafter." ;
    ct:source_path "cuad/BANUESTRAFINANCIALCORP_09_08_2006-EX-10.16-AGENCY AGREEMENT.txt" ;
    ct:source_sha256 "8a409e55f61a647c258e02748912d68112b3a13fce72f17a060135157c73cd9c" ;
    ct:start_char 8077 .

ex:C012P0093 a ct:SourcePassage ;
    ct:end_char 41248 ;
    ct:exact_text "12. Representations and Indemnities to Survive. All representations, warranties and agreements contained in this Agreement of the Company and the Agent shall remain in full force and effect, regardless of any termination or cancellation of this Agreement, and shall survive delivery of and payment for the Shares." ;
    ct:source_path "cuad/BANUESTRAFINANCIALCORP_09_08_2006-EX-10.16-AGENCY AGREEMENT.txt" ;
    ct:source_sha256 "8a409e55f61a647c258e02748912d68112b3a13fce72f17a060135157c73cd9c" ;
    ct:start_char 40935 .

ex:C012P0094 a ct:SourcePassage ;
    ct:end_char 41889 ;
    ct:exact_text "13. Termination and Payment of Expenses. This Agreement shall become effective on the date hereof and shall terminate upon the termination of the Offering. If for any reason any Shares are not delivered by or on behalf of the Company as provided herein, the Company will reimburse the Agent for all actual and accountable out-of-pocket expenses, including fees and disbursements of counsel, reasonably incurred by the Agent in making preparations for the purchase, sale and delivery of the Shares not so delivered, but the Company shall then be under no further liability to the Agent except as provided in Section 8 and Section 10 hereof." ;
    ct:source_path "cuad/BANUESTRAFINANCIALCORP_09_08_2006-EX-10.16-AGENCY AGREEMENT.txt" ;
    ct:source_sha256 "8a409e55f61a647c258e02748912d68112b3a13fce72f17a060135157c73cd9c" ;
    ct:start_char 41250 .

ex:C012R0001 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 18" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C012R0001Condition18 ;
    ct:supported_by ex:C012P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C012R0001Condition18 a ct:Condition ;
    ct:description "On the basis of the representations and warranties and subject to the terms and conditions of this Agreement, the Agent accepts such appointment. The Agent shall not be obligated to purchase any Shares and shall not be obligated to take any action which Agent deems to be inconsistent with any applicable law, regulation, decision or order. Subscriptions will be offered as described in the Registration Statement. Except as otherwise provided in this Agreement, the appointment of the Agent will terminate upon completion, expiration or termination of the Offering." ;
    ct:supported_by ex:C012P0018 ;
    meta:review_status "UNREVIEWED" .

