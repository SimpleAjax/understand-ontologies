ex:C012 a ct:Agreement ;
    rdfs:label "BANUESTRAFINANCIALCORP_09_08_2006-EX-10.16-AGENCY AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C012R0001,
        ex:C012R0002,
        ex:C012R0003,
        ex:C012R0004,
        ex:C012R0005,
        ex:C012R0006,
