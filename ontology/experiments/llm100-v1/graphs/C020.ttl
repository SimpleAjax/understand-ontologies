ex:C020R0006Condition102 a ct:Condition ;
    ct:description "months, each such extension commencing at the end of the last day of the      Initial Term or the relevant anniversary thereof, unless either Party      serves written notice of termination on the other Party at least 65 days      prior to the end of the Initial Term, or any subsequent extension." ;
    ct:supported_by ex:C020P0102 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0007 a ct:Rule ;
    rdfs:label "Termination — source passage 103" ;
    ct:kind "TERMINATION" ;
