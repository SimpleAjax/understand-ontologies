ex:C020R0009Condition106 a ct:Condition ;
    ct:description "9.4  If the Principal fails to perform within 30 days upon notice from the      Company on nonperformance by the Principal of any of its obligations under      this Contract, and keeps non-performing it, then the Company is entitled,      upon expiry of such 30 day period, to terminate this Contract, with      obligatory accounts settling." ;
    ct:supported_by ex:C020P0106 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0010 a ct:Rule ;
    rdfs:label "Termination — source passage 110" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C020R0010Ref0 ;
    ct:subject_to ex:C020R0010Condition110 ;
    ct:supported_by ex:C020P0110 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0010Condition110 a ct:Condition ;
    ct:description "10.3 If performance of the obligations by any Party under this Contract have      been delayed for a period of 3 months, the other Party shall be entitled to      terminate this Contract thereafter by giving notice to that effect to the      Party claiming relief under Section 10, with obligatory accounts settling." ;
    ct:supported_by ex:C020P0110 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0010Ref0 a ct:Reference ;
    rdfs:label "Section 10" ;
    ct:resolution_status "UNRESOLVED" .

ex:C020P0101 a ct:SourcePassage ;
    ct:end_char 16904 ;
    ct:exact_text "9.1  In accordance with items 9.3, 9.4, and 10.3, this Contract shall come into      force on the Effective Date, remain effective throughout the Initial Term,      and be prolonged, or further extended automatically for a period of 12" ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 16669 .

ex:C020P0102 a ct:SourcePassage ;
    ct:end_char 17212 ;
    ct:exact_text "months, each such extension commencing at the end of the last day of the      Initial Term or the relevant anniversary thereof, unless either Party      serves written notice of termination on the other Party at least 65 days      prior to the end of the Initial Term, or any subsequent extension." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 16915 .

ex:C020P0103 a ct:SourcePassage ;
    ct:end_char 17380 ;
    ct:exact_text "9.2  Any notice of termination served by any Party with violation of the period      of notice required by item 9.1 shall be invalid and of no effect      whatsoever." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 17214 .

ex:C020P0106 a ct:SourcePassage ;
    ct:end_char 18105 ;
    ct:exact_text "9.4  If the Principal fails to perform within 30 days upon notice from the      Company on nonperformance by the Principal of any of its obligations under      this Contract, and keeps non-performing it, then the Company is entitled,      upon expiry of such 30 day period, to terminate this Contract, with      obligatory accounts settling." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 17764 .

ex:C020P0110 a ct:SourcePassage ;
    ct:end_char 19878 ;
    ct:exact_text "10.3 If performance of the obligations by any Party under this Contract have      been delayed for a period of 3 months, the other Party shall be entitled to      terminate this Contract thereafter by giving notice to that effect to the      Party claiming relief under Section 10, with obligatory accounts settling." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
