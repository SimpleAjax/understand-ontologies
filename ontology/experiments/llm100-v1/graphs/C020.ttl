    ct:supported_by ex:C020P0103 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0007Condition103 a ct:Condition ;
    ct:description "9.2  Any notice of termination served by any Party with violation of the period      of notice required by item 9.1 shall be invalid and of no effect      whatsoever." ;
    ct:supported_by ex:C020P0103 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0008 a ct:Rule ;
    rdfs:label "Termination — source passage 104" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C020P0104 ;
    meta:review_status "UNREVIEWED" .

ex:C020R0009 a ct:Rule ;
    rdfs:label "Termination — source passage 106" ;
