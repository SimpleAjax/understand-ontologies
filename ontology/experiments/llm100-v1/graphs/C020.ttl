ct:end_char a owl:DatatypeProperty .

ct:end_date_status a owl:DatatypeProperty .

ct:ends_on_event a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:exact_text a owl:DatatypeProperty .

ct:has_party a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Party .

ct:has_rule a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Rule .

ct:kind a owl:DatatypeProperty .

ct:notice_actor a owl:DatatypeProperty .

ct:notice_form a owl:DatatypeProperty .

ct:notice_period_status a owl:DatatypeProperty .

ct:qualifies a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Rule .

ct:references_section a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:renewal_count a owl:DatatypeProperty .

ct:resolution_status a owl:DatatypeProperty .

ct:resolved_to a owl:ObjectProperty ;
    rdfs:domain ct:Reference ;
    rdfs:range ct:SourcePassage .

ct:source_path a owl:DatatypeProperty .

ct:source_sha256 a owl:DatatypeProperty .

ct:start_char a owl:DatatypeProperty .

ct:starts_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:stated_end_date a owl:DatatypeProperty .

ct:subject_to a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Condition .

ct:supported_by a owl:ObjectProperty ;
    rdfs:range ct:SourcePassage .

ct:termination_notice a owl:DatatypeProperty .

ex:C020 a ct:Agreement ;
    rdfs:label "CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C020R0001,
        ex:C020R0002,
        ex:C020R0003,
        ex:C020R0004,
        ex:C020R0005,
        ex:C020R0006,
        ex:C020R0007,
        ex:C020R0008,
        ex:C020R0009,
        ex:C020R0010 ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C020P0025 a ct:SourcePassage ;
    ct:end_char 3993 ;
    ct:exact_text "\"Initial Term\" means the period commencing on the Effective Date and concluding on the last day of the month in which the fifth anniversary of the Offtake Agreement Effective Date falls." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 3807 .

ex:C020P0035 a ct:SourcePassage ;
    ct:end_char 5399 ;
    ct:exact_text "\"Principal Period\" means the period from the Effective Date to the CPC Pipeline Operational Date." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 5302 .

ex:C020P0038 a ct:SourcePassage ;
    ct:end_char 5731 ;
    ct:exact_text "\"Secondary Period\" means the period from the CPC Pipeline Operational Date to the date of termination of this Contract (inclusive)." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 5600 .

ex:C020P0104 a ct:SourcePassage ;
    ct:end_char 17720 ;
    ct:exact_text "9.3  If the Company fails to perform within 30 days upon notice from the      Principal on nonperformance by the Company of any of its obligations under      this Contract, and keeps non-performing it, then the Principal may upon      expiry of the indicated 30 day period, terminate this Contract, with      obligatory accounts settling." ;
    ct:source_path "cuad/CHAPARRALRESOURCESINC_03_30_2000-EX-10.66-TRANSPORTATION CONTRACT.txt" ;
    ct:source_sha256 "0e03737ee6eafee156bb168e59f3134ba959e8e5f38ef4b5548a62798caf3174" ;
    ct:start_char 17382 .

