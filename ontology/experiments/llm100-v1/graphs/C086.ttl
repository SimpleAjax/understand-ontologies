ex:C086 a ct:Agreement ;
    rdfs:label "USASYNTHETICFUELCORP_10_21_2010-EX-10.10-STRATEGIC ALLIANCE AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C086R0001,
        ex:C086R0002,
        ex:C086R0003,
        ex:C086R0004,
        ex:C086R0005,
        ex:C086R0006,
