ex:C019P0157 a ct:SourcePassage ;
    ct:end_char 55414 ;
    ct:exact_text "IGER shall keep accurate and detailed records in accordance with good accounting practices of all expenses and extramural income, if any, relating  to the RESEARCH PROJECTS. All such records shall be subject to inspection by an independent auditor designated by CERES and reasonably  acceptable to IGER within normal business hours with at least fourteen (14) days notice. Such inspection rights shall terminate, with respect to  each RESEARCH PROJECT, on the third anniversary of the expiration or termination of such RESEARCH PROJECT." ;
    ct:source_path "cuad/CERES,INC_01_25_2012-EX-10.20-Collaboration Agreement.txt" ;
    ct:source_sha256 "83b3bd9444f56aeb9d1d4e5191c6f717356bca0b5d8c8da05e910aa49ec0af7b" ;
    ct:start_char 54878 .

