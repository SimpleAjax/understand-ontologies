ex:C019R0045Condition701 a ct:Condition ;
    ct:description "16.2 Each Party shall have the right to terminate this Agreement unilaterally by giving written notice of termination to the other Party if such other  Party fails to satisfy its material obligations, which shall include but are not limited to, making required reports and making required payments,  under this Agreement, and such Party subsequently fails to cure such failure(s) within (a) thirty (30) days for failures to remit payment for amounts  due under this Agreement and (b) ninety (90) days for all other obligations after receipt of written notice from the non-breaching Party specifying  such failure." ;
    ct:supported_by ex:C019P0701 ;
    meta:review_status "UNREVIEWED" .

ex:C019R0046 a ct:Rule ;
    rdfs:label "Termination — source passage 702" ;
