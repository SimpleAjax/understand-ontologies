ex:C047R0010 a ct:Rule ;
    rdfs:label "Termination — source passage 107" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C047P0107 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0011 a ct:Rule ;
