        ex:C047R0011 ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C047P0068 a ct:SourcePassage ;
    ct:end_char 13331 ;
    ct:exact_text "(a)  HCI shall pay MLX a guaranteed fixed sum of [*] US per annum during the      Initial Term of this Agreement to be paid out as a monthly payment of [*]      US (the \"Monthly Payment\"). This Monthly Payment shall be due by the 10th      day of each month;" ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 13073 .

ex:C047P0092 a ct:SourcePassage ;
    ct:end_char 20371 ;
    ct:exact_text "The term of this Agreement shall be for a period of two (2) years (the \"Term\"). The effective date of the start of the Term will be from the Launch Date." ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 20218 .

ex:C047P0093 a ct:SourcePassage ;
    ct:end_char 20390 ;
    ct:exact_text "11.2  Termination" ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 20373 .

ex:C047P0095 a ct:SourcePassage ;
    ct:end_char 20804 ;
    ct:exact_text "(b)  This Agreement may be terminated by a Party immediately, without notice:" ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 20727 .

ex:C047P0100 a ct:SourcePassage ;
    ct:end_char 21599 ;
    ct:exact_text "(d)  Upon termination or expiration of this Agreement for any reason:" ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 21530 .

ex:C047P0102 a ct:SourcePassage ;
    ct:end_char 21981 ;
    ct:exact_text "(ii)    the Parties shall immediately return to each other all property of              the other and cease using or distributing all advertising or              promotional materials, if any, containing references to the other              Party or the other Party's product;" ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 21705 .

ex:C047P0107 a ct:SourcePassage ;
    ct:end_char 22872 ;
    ct:exact_text "11.3  The exercise of a right of termination or other right or remedy in       connection with this Agreement shall be without prejudice to any other       right or remedy to which the terminating party may be entitled under this       Agreement or applicable law." ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 22608 .

ex:C047P0150 a ct:SourcePassage ;
    ct:end_char 34631 ;
    ct:exact_text "Each Party shall keep confidential any information, data and reports obtained in connection with this Agreement, unless such information has been rightfully obtained from a third party or is generally available to the public, or as must be disclosed by law. Upon termination of this Agreement, each of the parties (the \"Receiving Party\") shall return to the other party (the \"Disclosing Party\") any records or copies thereof which it may have obtained from the Disclosing Party in connection with its review of the Disclosing Party's business, other than information otherwise rightfully obtained by Receiving Party, acting in good faith, from someone other than the Disclosing Party or generally available to the public. Each party shall hold the terms and provisions of this Agreement confidential and shall not disclose its terms to any person except to its management. Notwithstanding the foregoing, this Agreement and the LOI is subject to the terms and conditions of the Confidentiality and Non-Disclosure Agreement signed between the Parties dated May 3rd, 1999." ;
    ct:source_path "cuad/HealthcentralCom_19991108_S-1A_EX-10.27_6623292_EX-10.27_Co-Branding Agreement.txt" ;
    ct:source_sha256 "d4402382bb26ede59c4ba8f382d8fa23b6f815bc9fcd914181368d1e1e5aee73" ;
    ct:start_char 33562 .

ex:C047R0001 a ct:Rule ;
    rdfs:label "Initial Term — source passage 68" ;
    ct:kind "INITIAL_TERM" ;
    ct:supported_by ex:C047P0068 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0002 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 82" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C047R0002Condition82 ;
    ct:supported_by ex:C047P0082 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0002Condition82 a ct:Condition ;
    ct:description "During the Term of the Agreement, and subject to the following requirements respecting Canadian content levels as set out in paragraphs 3(f), (g) and (h), HCI shall be the exclusive health content partner in the health section of the Sympatico web site, provided however, that nothing contained herein shall prevent MediaLinx from entering into an agreement with other parties for: i) a health based web directory; or ii) other health related content whose content does not compete with the content contained on the Co-Branded Site; which in no event shall receive no more than one fifth (1/5th) of the promotion and which shall constitute no more than one fifth (1/5th) of the total health related content which resides on the home page of the Sympatico Health section. In the event that MediaLinx obtains a web guide from a third party, MediaLinx and HCI shall discuss how to present both web guides to the user, and make best effort to agree to the kind of experience that the user shall have when utilizing the new web guide. If, at any time during the Term of this Agreement, HCI fails to meet the content requirements set out in paragraphs 3(f), (g) and (h), HCI shall no longer be entitled to be the exclusive health content partner in the health section of the Sympatico web site. " ;
    ct:supported_by ex:C047P0082 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0003 a ct:Rule ;
    rdfs:label "Initial Term — source passage 92" ;
    ct:kind "INITIAL_TERM" ;
    ct:supported_by ex:C047P0092 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0004 a ct:Rule ;
    rdfs:label "Termination — source passage 93" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C047P0093 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0005 a ct:Rule ;
    rdfs:label "Termination — source passage 94" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C047R0005Condition94 ;
    ct:supported_by ex:C047P0094 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0005Condition94 a ct:Condition ;
    ct:description "(a)  Either Party may terminate this Agreement upon 30 days prior written notice      to the other Party if 1) such other Party breaches any material term of      this Agreement, unless such breach is cured within 30 days; or 2) if any of      the terms of this Agreement that require mutual approval are not mutually      agreed to;" ;
    ct:supported_by ex:C047P0094 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0006 a ct:Rule ;
    rdfs:label "Termination — source passage 95" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C047P0095 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0007 a ct:Rule ;
    rdfs:label "Termination — source passage 99" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C047R0007Condition99 ;
    ct:supported_by ex:C047P0099 ;
    meta:review_status "UNREVIEWED" .

ex:C047R0007Condition99 a ct:Condition ;
    ct:description "(c)  Either party may terminate this Agreement upon 30 days written notice if      either Party's corporate structure has undergone a material ownership      change such that its corporate interests are then in conflict with the      corporate interests of the other Party; and" ;
    ct:supported_by ex:C047P0099 ;
    meta:review_status "UNREVIEWED" .

