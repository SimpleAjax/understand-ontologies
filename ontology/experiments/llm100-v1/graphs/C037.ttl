    rdfs:label "Party" .

ex:C037P0152 a ct:SourcePassage ;
    ct:end_char 19410 ;
    ct:exact_text "11.1.5. Except as provided hereinafter, for a period of five years after termination or expiration of this Agreement, each party shall not disclose, publish or disseminate information received from the other party which may be required to carry out this Agreement and which the disclosing party deems proprietary and confidential." ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 19080 .

ex:C037P0153 a ct:SourcePassage ;
    ct:end_char 19705 ;
    ct:exact_text "11.1.6. Once this Agreement has expired, each party must, depending on the choice of the other party, destroy or hand over all technical, economic, financial or commercial information, confidential or not, in its possession, directly or indirectly, as convened in the present Agreement.   11" ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 19414 .

ex:C037P0171 a ct:SourcePassage ;
    ct:end_char 21905 ;
    ct:exact_text "14.1. The Customer can cancel, on its own accord, the present Agreement upon certified notice to EIT, in the following cases:" ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 21780 .

ex:C037P0180 a ct:SourcePassage ;
    ct:end_char 23462 ;
    ct:exact_text "15.1. In case of expiration or termination of the present Agreement, the Customer and EIT will cooperate, in good faith, to make possible a transfer, in due form to the Customer or to a third party, chosen by the Customer, for the provision of the services defined in this Agreement. For that purpose, the parties will develop, with enough time in advance and with the necessary haste, a Transition Plan where the actions and measures to be taken will be defined.   13" ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 22994 .

ex:C037P0182 a ct:SourcePassage ;
    ct:end_char 23750 ;
    ct:exact_text "15.2. EIT will continue to provide the services defined in this Agreement between the date it receives from the Customer a notice ofexpiration or termination of this Agreement and the date this expiration or termination becomes effective." ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 23512 .

