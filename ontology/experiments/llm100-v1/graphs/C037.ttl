ex:C037P0168 a ct:SourcePassage ;
    ct:end_char 21560 ;
    ct:exact_text "13.1. The present Agreement is effective as from 1 January 2009. It is established by calendar year and renewed tacitly every year." ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 21429 .

ex:C037P0169 a ct:SourcePassage ;
    ct:end_char 21753 ;
    ct:exact_text "13.2. The Agreement rests, for all that, cancellable at any time by any of the parties before the expiry date of the Agreement or any of itsrenewals, upon three months prior written notice." ;
    ct:source_path "cuad/FerroglobePlc_20150624_F-4A_EX-10.20_9154746_EX-10.20_Outsourcing Agreement.txt" ;
    ct:source_sha256 "64d989b896faeaaf5faa295dff3acce9ce13bf3b8a223b39ec2da903240b25da" ;
    ct:start_char 21564 .

