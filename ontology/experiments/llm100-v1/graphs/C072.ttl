ex:C072 a ct:Agreement ;
    rdfs:label "RISEEDUCATIONCAYMANLTD_04_17_2020-EX-4.23-SERVICE AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C072R0001,
        ex:C072R0002,
        ex:C072R0003,
