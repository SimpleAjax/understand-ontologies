    ct:source_path "cuad/RISEEDUCATIONCAYMANLTD_04_17_2020-EX-4.23-SERVICE AGREEMENT.txt" ;
    ct:source_sha256 "4d9af82e13bc95c4459e66c7d19439753237bc89e6e4bf10819aedcc4018534f" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C072P0037 a ct:SourcePassage ;
    ct:end_char 11251 ;
    ct:exact_text "Either Party's failure to exercise the right to claim liquidated damages or indemnification for losses against the other Party shall not be deemed as a waiver of such right. 10. Termination" ;
    ct:source_path "cuad/RISEEDUCATIONCAYMANLTD_04_17_2020-EX-4.23-SERVICE AGREEMENT.txt" ;
    ct:source_sha256 "4d9af82e13bc95c4459e66c7d19439753237bc89e6e4bf10819aedcc4018534f" ;
    ct:start_char 11062 .

ex:C072R0001 a ct:Rule ;
    rdfs:label "Post Expiry Continuation — source passage 33" ;
    ct:kind "POST_EXPIRY_CONTINUATION" ;
    ct:subject_to ex:C072R0001Condition33 ;
    ct:supported_by ex:C072P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0001Condition33 a ct:Condition ;
    ct:description "The Parties covenant and confirm that any verbal communications, written documents or electronic information (including but not limited to software codes and any contents contained in the software) relating to this Agreement between the Parties shall be confidential information. Neither Party may disclose any confidential information of the other Party without prior written consent from the other Party, except that: (1) relevant information has been made public not as a result of any fault or disclosure by the information recipient; (2) such disclosure is required under applicable laws or regulations or rules of securities exchanges. Any employees of one Party disclosing any confidential information shall be deemed as the Party disclosing confidential information and such Party shall be liable therefor under this Agreement. This clause shall survive the termination of this Agreement. 4" ;
    ct:supported_by ex:C072P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0002 a ct:Rule ;
    rdfs:label "Termination — source passage 36" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C072R0002Condition36 ;
    ct:supported_by ex:C072P0036 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0002Condition36 a ct:Condition ;
    ct:description "Notwithstanding the foregoing, upon any delay by Service Recipient in its payment of any Service Fee to Service Provider, for each day of delay in such payment, Service Recipient must pay Service Provider liquidated damages at 0.5 percent (0.5%) of the Service Fee that are due and unpaid. In the event that such delay in payment is more than fifteen (15) days, Service Provider may terminate this Agreement. Service Recipient shall be liable for indemnifying Service Provider in full for the losses it incurred therefrom." ;
    ct:supported_by ex:C072P0036 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0003 a ct:Rule ;
    rdfs:label "Termination — source passage 37" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C072P0037 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0004 a ct:Rule ;
    rdfs:label "Termination — source passage 38" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C072R0004Condition38 ;
    ct:supported_by ex:C072P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0004Condition38 a ct:Condition ;
    ct:description "This Agreement shall be terminated upon the occurrence of any of the following: (1) The validity period of this Agreement expires and the Parties fail to reach an agreement on renewal; (2) The Parties mutually agree to terminate this Agreement; or (3) Service Provider exercises the right to terminate this Agreement upon a default by Service Recipient." ;
    ct:supported_by ex:C072P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0005 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 38" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C072R0005Condition38 ;
    ct:supported_by ex:C072P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0005Condition38 a ct:Condition ;
    ct:description "This Agreement shall be terminated upon the occurrence of any of the following: (1) The validity period of this Agreement expires and the Parties fail to reach an agreement on renewal; (2) The Parties mutually agree to terminate this Agreement; or (3) Service Provider exercises the right to terminate this Agreement upon a default by Service Recipient." ;
    ct:supported_by ex:C072P0038 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0006 a ct:Rule ;
    rdfs:label "Termination — source passage 39" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C072R0006Condition39 ;
    ct:supported_by ex:C072P0039 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0006Condition39 a ct:Condition ;
    ct:description "If this Agreement is terminated by Service Provider upon a default by Service Recipient, Service Provider will not refund the prepaid Service Fee to Service Recipient. 11. Notice" ;
    ct:supported_by ex:C072P0039 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0007 a ct:Rule ;
    rdfs:label "Initial Term — source passage 50" ;
    ct:kind "INITIAL_TERM" ;
    ct:subject_to ex:C072R0007Condition50 ;
    ct:supported_by ex:C072P0050 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0007Condition50 a ct:Condition ;
    ct:description "This Agreement shall be effective as of the date set forth above in this Agreement. The term of this Agreement shall be five (5) years. This Agreement shall be renewed automatically for another five (5) years upon the expiration unless the Parties confirm, in writing, the termination of this Agreement. 14. Miscellaneous (1) [This Agreement shall supersede other service agreements previously entered into by both Parties. In case of any conflicts in any terms and conditions or any dispute on the interpretation, application or implementation of this Agreement, this Agreement shall prevail. Any amendment to this Agreement shall be in writing and executed by both Parties hereto.] (2) This Agreement is executed in two (2) original copies and each Party shall hold one original copy. Both original copies shall have the same legal effect. (3) This Agreement shall become effective upon being affixed with both Parties' official seals." ;
    ct:supported_by ex:C072P0050 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0008 a ct:Rule ;
    rdfs:label "Automatic Renewal — source passage 50" ;
    ct:kind "AUTOMATIC_RENEWAL" ;
    ct:subject_to ex:C072R0008Condition50 ;
    ct:supported_by ex:C072P0050 ;
    meta:review_status "UNREVIEWED" .

ex:C072R0008Condition50 a ct:Condition ;
    ct:description "This Agreement shall be effective as of the date set forth above in this Agreement. The term of this Agreement shall be five (5) years. This Agreement shall be renewed automatically for another five (5) years upon the expiration unless the Parties confirm, in writing, the termination of this Agreement. 14. Miscellaneous (1) [This Agreement shall supersede other service agreements previously entered into by both Parties. In case of any conflicts in any terms and conditions or any dispute on the interpretation, application or implementation of this Agreement, this Agreement shall prevail. Any amendment to this Agreement shall be in writing and executed by both Parties hereto.] (2) This Agreement is executed in two (2) original copies and each Party shall hold one original copy. Both original copies shall have the same legal effect. (3) This Agreement shall become effective upon being affixed with both Parties' official seals." ;
    ct:supported_by ex:C072P0050 ;
    meta:review_status "UNREVIEWED" .

