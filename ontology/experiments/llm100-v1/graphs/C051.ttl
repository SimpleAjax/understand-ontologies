ex:C051 a ct:Agreement ;
    rdfs:label "KIROMICBIOPHARMA,INC_04_08_2020-EX-10.28-JOINT VENTURE AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C051R0001,
        ex:C051R0002,
        ex:C051R0003,
