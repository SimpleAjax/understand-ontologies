ex:C006R0014Condition69 a ct:Condition ;
    ct:description "any other.  In the event of the merger or consolidation of the Company with any other entity, Nantz Communications shall have the right to terminate the Agreement by so notifying the Company in writing on or before sixty (60) days" ;
    ct:supported_by ex:C006P0069 ;
    meta:review_status "UNREVIEWED" .

