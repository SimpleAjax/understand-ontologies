ex:C006P0013 a ct:SourcePassage ;
    ct:end_char 2121 ;
    ct:exact_text "CONTRACT YEAR shall mean a period of twelve (12) successive months commencing on any first day of June during the Term." ;
    ct:source_path "cuad/ASHWORTHINC_01_29_1999-EX-10.(D)-PROMOTION AGREEMENT AND NANTZ COMMUNICATIONS, INC..txt" ;
    ct:source_sha256 "977154e5d3a369d6eba47a390737030f8a6482bdf1a28dff81ca0427baac2ad3" ;
    ct:start_char 2002 .

ex:C006P0016 a ct:SourcePassage ;
    ct:end_char 2712 ;
    ct:exact_text "2.   TERM.  Except as otherwise provided herein, this Agreement shall commence      effective June 1, 1998, and shall continue for a term of three (3) years      expiring May 31, 2001 (the \"Term\")." ;
    ct:source_path "cuad/ASHWORTHINC_01_29_1999-EX-10.(D)-PROMOTION AGREEMENT AND NANTZ COMMUNICATIONS, INC..txt" ;
    ct:source_sha256 "977154e5d3a369d6eba47a390737030f8a6482bdf1a28dff81ca0427baac2ad3" ;
    ct:start_char 2515 .

ex:C006P0055 a ct:SourcePassage ;
    ct:end_char 15108 ;
    ct:exact_text "TERMINATION" ;
    ct:source_path "cuad/ASHWORTHINC_01_29_1999-EX-10.(D)-PROMOTION AGREEMENT AND NANTZ COMMUNICATIONS, INC..txt" ;
    ct:source_sha256 "977154e5d3a369d6eba47a390737030f8a6482bdf1a28dff81ca0427baac2ad3" ;
    ct:start_char 15097 .

ex:C006P0056 a ct:SourcePassage ;
    ct:end_char 15187 ;
    ct:exact_text "This Agreement may be terminated by any party in the following circumstances:" ;
    ct:source_path "cuad/ASHWORTHINC_01_29_1999-EX-10.(D)-PROMOTION AGREEMENT AND NANTZ COMMUNICATIONS, INC..txt" ;
    ct:source_sha256 "977154e5d3a369d6eba47a390737030f8a6482bdf1a28dff81ca0427baac2ad3" ;
    ct:start_char 15110 .

ex:C006P0058 a ct:SourcePassage ;
    ct:end_char 15440 ;
    ct:exact_text "19.  Nantz's Disability or death, in which event the Agreement shall terminate      on the May 1 following such Disability or death;" ;
    ct:source_path "cuad/ASHWORTHINC_01_29_1999-EX-10.(D)-PROMOTION AGREEMENT AND NANTZ COMMUNICATIONS, INC..txt" ;
    ct:source_sha256 "977154e5d3a369d6eba47a390737030f8a6482bdf1a28dff81ca0427baac2ad3" ;
    ct:start_char 15308 .

ex:C006P0067 a ct:SourcePassage ;
    ct:end_char 18280 ;
    ct:exact_text "From and after the termination of the Term all of the rights of the Company to the use of the Endorsement shall cease absolutely and the Company shall not thereafter use or refer to the Endorsement in advertising or promotion in any manner whatsoever.  The Company shall not advertise, promote, distribute or sell any item whatsoever in connection with the use of any name, figure, design, logo, trademark or trade name confusingly similar to or suggestive of the Endorsement following the termination of the Term." ;
    ct:source_path "cuad/ASHWORTHINC_01_29_1999-EX-10.(D)-PROMOTION AGREEMENT AND NANTZ COMMUNICATIONS, INC..txt" ;
    ct:source_sha256 "977154e5d3a369d6eba47a390737030f8a6482bdf1a28dff81ca0427baac2ad3" ;
    ct:start_char 17766 .

