ct: a owl:Ontology ;
    rdfs:comment "Partial five-contract development sample. No claim of complete contract coverage or legal correctness." .

ct:agreement_effective_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:applies_within a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:calendar_date_status a owl:DatatypeProperty .

ct:coverage a owl:DatatypeProperty .

ct:description a owl:DatatypeProperty .

ct:duration a owl:DatatypeProperty .

ct:duration_status a owl:DatatypeProperty .

ct:end_char a owl:DatatypeProperty .

ct:end_date_status a owl:DatatypeProperty .

ct:ends_on_event a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:exact_text a owl:DatatypeProperty .

ct:has_party a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Party .

ct:has_rule a owl:ObjectProperty ;
    rdfs:domain ct:Agreement ;
    rdfs:range ct:Rule .

ct:kind a owl:DatatypeProperty .

ct:notice_actor a owl:DatatypeProperty .

ct:notice_form a owl:DatatypeProperty .

ct:notice_period_status a owl:DatatypeProperty .

ct:qualifies a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Rule .

ct:references_section a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:renewal_count a owl:DatatypeProperty .

ct:resolution_status a owl:DatatypeProperty .

ct:resolved_to a owl:ObjectProperty ;
    rdfs:domain ct:Reference ;
    rdfs:range ct:SourcePassage .

ct:source_path a owl:DatatypeProperty .

ct:source_sha256 a owl:DatatypeProperty .

ct:start_char a owl:DatatypeProperty .

ct:starts_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:stated_end_date a owl:DatatypeProperty .

ct:subject_to a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Condition .

ct:supported_by a owl:ObjectProperty ;
    rdfs:range ct:SourcePassage .

ct:termination_notice a owl:DatatypeProperty .

ex:C079 a ct:Agreement ;
    rdfs:label "SPHERE3DCORP_06_24_2020-EX-10.12-CONSULTING AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C079R0001,
        ex:C079R0002,
        ex:C079R0003,
        ex:C079R0004 ;
    ct:source_path "cuad/SPHERE3DCORP_06_24_2020-EX-10.12-CONSULTING AGREEMENT.txt" ;
    ct:source_sha256 "4fcfd8db0d74abd10832ecbc5658a6a3b30e5a16a1220a462394ac9eb43b3268" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C079P0010 a ct:SourcePassage ;
    ct:end_char 3224 ;
    ct:exact_text "CONSULTING SERVICES & COMPENSATION. Commencing on the Effective Date, the Consultant will be retained as a Consultant and independent contractor for the Company for the Term as set forth in Section 3. For services rendered hereunder during the term, the Consultant shall receive:" ;
    ct:source_path "cuad/SPHERE3DCORP_06_24_2020-EX-10.12-CONSULTING AGREEMENT.txt" ;
    ct:source_sha256 "4fcfd8db0d74abd10832ecbc5658a6a3b30e5a16a1220a462394ac9eb43b3268" ;
    ct:start_char 2945 .

ex:C079P0015 a ct:SourcePassage ;
    ct:end_char 4454 ;
    ct:exact_text "TERM & TERMINATION. This Agreement is for a term (the \"Term\") of 12 months from the Effective Date on June 1s t 2020 and expiring May 31st 2021." ;
    ct:source_path "cuad/SPHERE3DCORP_06_24_2020-EX-10.12-CONSULTING AGREEMENT.txt" ;
    ct:source_sha256 "4fcfd8db0d74abd10832ecbc5658a6a3b30e5a16a1220a462394ac9eb43b3268" ;
    ct:start_char 4310 .

ex:C079P0017 a ct:SourcePassage ;
    ct:end_char 4855 ;
    ct:exact_text "Upon termination, Consultant agrees to perform the necessary information transfer required at the time." ;
    ct:source_path "cuad/SPHERE3DCORP_06_24_2020-EX-10.12-CONSULTING AGREEMENT.txt" ;
    ct:source_sha256 "4fcfd8db0d74abd10832ecbc5658a6a3b30e5a16a1220a462394ac9eb43b3268" ;
    ct:start_char 4752 .

ex:C079R0001 a ct:Rule ;
    rdfs:label "Initial Term — source passage 10" ;
    ct:kind "INITIAL_TERM" ;
    ct:references_section ex:C079R0001Ref0 ;
    ct:supported_by ex:C079P0010 ;
    meta:review_status "UNREVIEWED" .

ex:C079R0001Ref0 a ct:Reference ;
    rdfs:label "Section 3" ;
    ct:resolution_status "UNRESOLVED" .

ex:C079R0002 a ct:Rule ;
    rdfs:label "Initial Term — source passage 15" ;
    ct:kind "INITIAL_TERM" ;
    ct:supported_by ex:C079P0015 ;
    meta:review_status "UNREVIEWED" .

ex:C079R0003 a ct:Rule ;
    rdfs:label "Automatic Renewal — source passage 16" ;
    ct:kind "AUTOMATIC_RENEWAL" ;
    ct:subject_to ex:C079R0003Condition16 ;
    ct:supported_by ex:C079P0016 ;
    meta:review_status "UNREVIEWED" .

ex:C079R0003Condition16 a ct:Condition ;
    ct:description "(a) In the case that the company would not like to extend the terms of agreement for an additional month. The company must notify the consultant within 5 days of the conclusion of the 12 month term. Without notification the contract will automatically extend for an additional month of service." ;
    ct:supported_by ex:C079P0016 ;
    meta:review_status "UNREVIEWED" .

ex:C079R0004 a ct:Rule ;
    rdfs:label "Post Expiry Continuation — source passage 17" ;
    ct:kind "POST_EXPIRY_CONTINUATION" ;
    ct:supported_by ex:C079P0017 ;
    meta:review_status "UNREVIEWED" .

ct:Condition a owl:Class ;
    rdfs:label "Condition" .

ex:C079P0016 a ct:SourcePassage ;
    ct:end_char 4750 ;
    ct:exact_text "(a) In the case that the company would not like to extend the terms of agreement for an additional month. The company must notify the consultant within 5 days of the conclusion of the 12 month term. Without notification the contract will automatically extend for an additional month of service." ;
    ct:source_path "cuad/SPHERE3DCORP_06_24_2020-EX-10.12-CONSULTING AGREEMENT.txt" ;
