ex:C036P0158 a ct:SourcePassage ;
    ct:end_char 34466 ;
    ct:exact_text "3.2.1 Initial Development Plan. The initial Development Plan is attached hereto as Exhibit C (the \"Initial Development Plan\"), and shall be fixed for the period from the Effective Date through March 31, 2006, unless otherwise agreed by the JDC." ;
    ct:source_path "cuad/FIBROGENINC_10_01_2014-EX-10.11-COLLABORATION AGREEMENT.txt" ;
