ex:C032P0004 a ct:SourcePassage ;
    ct:end_char 419 ;
    ct:exact_text "This Agreement is made and entered into effective as of November 5, 1997 (the \"effective Date), by and between WatchGuard Technologies, Inc., a Delaware corporation (\"WGT\"), and European Micro (\"Distributor\"). WGT and Distributor agree as follows:" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 172 .

ex:C032P0015 a ct:SourcePassage ;
    ct:end_char 2393 ;
    ct:exact_text "\"Term\" means the period of time determined in accordance with Section 5." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 2321 .

ex:C032P0059 a ct:SourcePassage ;
    ct:end_char 12135 ;
    ct:exact_text "5.1  Term. The Term will commence on the Effective Date of this Agreement and      will remain in effect, unless sooner terminated under paragraphs 5.2, 5.3,      or 5.4, until the termination date specified in Exhibit A." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 11914 .

ex:C032P0061 a ct:SourcePassage ;
    ct:end_char 13002 ;
    ct:exact_text "5.2  Termination by WGT. Upon the occurrence of any of the following, WGT may      terminate the Term by giving Distributor written notice of such termination      for:" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 12834 .

ex:C032P0068 a ct:SourcePassage ;
    ct:end_char 14491 ;
    ct:exact_text "(f)  any failure by Distributor to perform any of its other obligations under      this Agreement where such failure continues for thirty (30) days after      written notice thereof by WGT to Distributor; or" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 14284 .

ex:C032P0069 a ct:SourcePassage ;
    ct:end_char 14635 ;
    ct:exact_text "(g)  WGT giving Distributor ninety (90) days' advance written notice of      termination at any time after the expiration of the Initial Term." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 14493 .

ex:C032P0071 a ct:SourcePassage ;
    ct:end_char 15639 ;
    ct:exact_text "5.4  Termination by Distributor. Upon the occurrence of any of the following,      Distributor may terminate the Term by giving WGT written notice of such      termination;" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 15467 .

ex:C032P0073 a ct:SourcePassage ;
    ct:end_char 16096 ;
    ct:exact_text "(b)  any failure by WGT to perform any of its obligations under this Agreement      where such failure continues for thirty (30) days after written notice      thereof by Distributor to WGT; or" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 15903 .

ex:C032P0074 a ct:SourcePassage ;
    ct:end_char 16437 ;
    ct:exact_text "(c)  for convenience whether or not extended beyond the Initial Term, provided      Distributor gives WGT thirty (30) days' advance written notice and, within      such thirty (30) day period, Distributor pays to WGT a lump-sum payment      equal to fifty (50%) of the unpaid balance of cumulative Guaranteed Minimum      Purchase amounts." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 16098 .

ex:C032P0075 a ct:SourcePassage ;
    ct:end_char 16885 ;
    ct:exact_text "5.5  Effect of Termination. Any termination pursuant to paragraphs 5.2, 5.3, or      5.4 will be without prejudice to any other right or remedy afforded to      either party under this Agreement or any applicable law (e.g., in the case      of any breach or default by the other party), and will not affect any      rights or obligations which have arisen prior to the date of such      termination. In the event of termination, Distributor will:" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 16439 .

ex:C032P0079 a ct:SourcePassage ;
    ct:end_char 17435 ;
    ct:exact_text "(c)  return to WGT within twenty (20) days following the expiration or      termination of the Term, any and all (i) demonstration Product provided to      Distributor; (ii) Products not already paid for in full by Distributor; and      (iii) promotional literature, data, information and other items received by      Distributor under this Agreement; and" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 17080 .

ex:C032P0081 a ct:SourcePassage ;
    ct:end_char 18065 ;
    ct:exact_text "Upon the expiration or termination of the Term, the license granted under Section 2 of this Agreement will terminate. Any end-user licenses of the Software granted under the terms of this Agreement will survive the end of the Term in accordance with the terms of the applicable end-user license agreement." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 17760 .

ex:C032P0082 a ct:SourcePassage ;
    ct:end_char 18983 ;
    ct:exact_text "5.6  Acknowledgment. Any expiration or termination of the Term will be final and      absolute. Except as expressly set forth in paragraphs 5.3 and 5.5(c),      Distributor waives any right, either express or implied by applicable law      or otherwise, to the renewal of this Agreement or to any damages or      compensation for any expiration or termination of the Term in accordance      with this Section 5. Each of the parties have considered the possibility of      such expiration or termination and the possibility of loss and damage      resulting therefrom in making expenditures pursuant to the performance of      this Agreement. It is the express intent and agreement of the parties that      neither will be liable to the other for damages, except as expressly set      forth in paragraphs 5.3 and 5.5(c), or otherwise by reason of the      expiration or termination of the Term as provided for herein." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 18067 .

ex:C032P0104 a ct:SourcePassage ;
    ct:end_char 23877 ;
    ct:exact_text "TERMINATION DATE:                                           September 30, 1997 TRADEMARKS:" ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 23787 .

ex:C032P0119 a ct:SourcePassage ;
    ct:end_char 26437 ;
    ct:exact_text "Section A.3 As a Full Service Master Distributor, Distributor agrees to sign up a minimum of 10 new WatchGuard resellers in the Territory within the Initial Term of the Agreement." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 26258 .

ex:C032P0169 a ct:SourcePassage ;
    ct:end_char 49959 ;
    ct:exact_text "25.  Survival. Paragraphs 1, 2, 3, 13 through 23 and all accrued obligations to      pay, together with all other provisions of this Agreement which may      reasonably be interpreted or construed as surviving the expiration or      termination of the Term, will survive the expiration or termination of the      Term." ;
    ct:source_path "cuad/EUROPEANMICROHOLDINGSINC_03_06_1998-EX-10.6-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "d806943ae391f6f5a4d5ee897e2b40107cc948056d0faff9d2e81d231fb059d8" ;
    ct:start_char 49641 .

