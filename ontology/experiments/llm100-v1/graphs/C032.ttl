ex:C032R0006Condition60 a ct:Condition ;
    ct:description "The Term will automatically renew for successive additional periods of one (1) year each, provided that: (a) Distributor has made all Guaranteed Minimum Purchases and has complied with the marketing requirements under paragraph 4.1(b); (b) the parties have agreed in writing upon the Guaranteed Minimum Purchase amounts and Product price discounts for the next subsequent one (1) year renewal period; (c) neither party provided the other party with notice of such party's intention not to renew this Agreement at least thirty (30) days prior to any year's Expiration Date; and (d) neither party provided the other party with such notice as may be required pursuant to paragraphs 5.2, 5.3 or 5.4." ;
    ct:supported_by ex:C032P0060 ;
    meta:review_status "UNREVIEWED" .

ex:C032R0006Ref0 a ct:Reference ;
    rdfs:label "paragraph 4.1(b)" ;
    ct:resolution_status "UNRESOLVED" .

