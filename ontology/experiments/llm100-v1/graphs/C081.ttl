    rdfs:label "Party" .

ex:C081R0001 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 32" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C081R0001Condition32 ;
    ct:supported_by ex:C081P0032 ;
    meta:review_status "UNREVIEWED" .

ex:C081R0001Condition32 a ct:Condition ;
    ct:description "7. Term and Termination. This Addendum may be terminated at any time by either Party in accordance with the termination provisions of the Distribution Agreement. The Addendum shall not have an Initial Period." ;
    ct:supported_by ex:C081P0032 ;
    meta:review_status "UNREVIEWED" .

ex:C081R0002 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 50" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C081R0002Condition50 ;
    ct:supported_by ex:C081P0050 ;
    meta:review_status "UNREVIEWED" .

ex:C081R0002Condition50 a ct:Condition ;
    ct:description "2. Purchase Order Rescheduling, Cancellation and Modification. Distributor has the right to cancel, reschedule or modify all or any portion of a purchase order that has been accepted by Xplore at no cost to Distributor only if such cancellation or modification request is made within [*****] business days of PO acceptance or rescheduling request is made at least [*****] business days prior to the most current Estimated Shipping Date for that purchase order. Distributor has the right to change the destination of all or any portion of a purchase order that has been accepted by Xplore at no cost to Distributor only if such change in destination request is made at least [*****] business days prior to the most current Estimated Shipping Date for that purchase order. Except as set forth above, purchase orders are non-changeable and non- cancellable by Distributor, once accepted by Xplore." ;
    ct:supported_by ex:C081P0050 ;
    meta:review_status "UNREVIEWED" .

ex:C081R0003 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 51" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C081R0003Condition51 ;
    ct:supported_by ex:C081P0051 ;
    meta:review_status "UNREVIEWED" .

ex:C081R0003Condition51 a ct:Condition ;
    ct:description "Certain purchase orders, determined at Xplore's sole discretion, and generally of large volume and/or extended lead times, may be subject to alternative rescheduling, cancellation, and modification rights. Should such purchase orders be subject to alternative rights, Xplore shall inform Distributor of alternative rights prior to order acceptance. Distributor will then have [*****] business days to accept, or reject, the alternative terms of Xplore for that certain purchase order. If Distributor rejects such alternative terms, the purchase order will not be accepted by Xplore." ;
    ct:supported_by ex:C081P0051 ;
    meta:review_status "UNREVIEWED" .

