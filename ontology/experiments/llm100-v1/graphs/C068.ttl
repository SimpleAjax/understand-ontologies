    rdfs:label "Section 5.1" ;
    ct:resolution_status "UNRESOLVED" .

ex:C068R0023Ref1 a ct:Reference ;
    rdfs:label "Appendix A" ;
    ct:resolution_status "UNRESOLVED" .

