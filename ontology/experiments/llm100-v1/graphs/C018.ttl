    rdfs:label "Termination — source passage 20" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C018R0008Condition20 ;
    ct:supported_by ex:C018P0020 ;
    meta:review_status "UNREVIEWED" .

