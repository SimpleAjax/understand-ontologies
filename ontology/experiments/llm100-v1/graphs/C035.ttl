ex:C035R0002 a ct:Rule ;
    rdfs:label "Termination — source passage 11" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C035R0002Condition11 ;
    ct:supported_by ex:C035P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C035R0002Condition11 a ct:Condition ;
    ct:description "written notice from the Adviser that this Limited Power of Attorney has been revoked. This Limited Power of Attorney shall be revoked and terminated automatically upon the cancellation or termination of the Services Agreement or as to any Fund upon the cancellation or termination of the Adviser's Investment Advisory Contract for such Fund. Except as provided in the immediately preceding sentence, the powers and authorities herein granted may be revoked or terminated by the Adviser at any time provided that no such revocation or termination shall be effective until FASC has received actual notice of such revocation or termination in writing from the Adviser." ;
    ct:supported_by ex:C035P0011 ;
    meta:review_status "UNREVIEWED" .

