ct:renewal_count a owl:DatatypeProperty .

ct:resolution_status a owl:DatatypeProperty .

ct:resolved_to a owl:ObjectProperty ;
    rdfs:domain ct:Reference ;
    rdfs:range ct:SourcePassage .

ct:source_path a owl:DatatypeProperty .

ct:source_sha256 a owl:DatatypeProperty .

ct:start_char a owl:DatatypeProperty .

ct:starts_from a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Reference .

ct:stated_end_date a owl:DatatypeProperty .

ct:subject_to a owl:ObjectProperty ;
    rdfs:domain ct:Rule ;
    rdfs:range ct:Condition .

ct:supported_by a owl:ObjectProperty ;
