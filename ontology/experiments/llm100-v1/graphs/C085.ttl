ex:C085 a ct:Agreement ;
    rdfs:label "TRUENORTHENERGYCORP_02_08_2007-EX-10.1-DEVELOPMENT AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C085R0001,
        ex:C085R0002,
        ex:C085R0003,
