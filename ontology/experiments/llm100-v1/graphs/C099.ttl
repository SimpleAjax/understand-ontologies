ex:C099P0033 a ct:SourcePassage ;
    ct:end_char 5010 ;
    ct:exact_text "\"TERM\"             means the term as set out in Clause 7; and" ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 4949 .

ex:C099P0054 a ct:SourcePassage ;
    ct:end_char 7877 ;
    ct:exact_text "2.5  XFN and/or its Affiliates have the right at any time to suspend or cease      distributing or making the Content available to the public." ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 7735 .

ex:C099P0064 a ct:SourcePassage ;
    ct:end_char 9703 ;
    ct:exact_text "Hundred Thousand) for a term of twenty (20) years, in cash or such other      consideration as the Parties may agree. The payment schedule shall be by      five (5) instalments of US$220,000 each. The first instalment will be      effect on condition that XFN can raise at least US$1.1 million additional      funding in 2002." ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 9377 .

ex:C099P0087 a ct:SourcePassage ;
    ct:end_char 12989 ;
    ct:exact_text "7.1  This Agreement shall take effect from the Effective Date and continue in      full force and effect for twenty (20) years thereafter, unless otherwise      terminated in accordance with Clause 8." ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 12789 .

ex:C099P0089 a ct:SourcePassage ;
    ct:end_char 13206 ;
    ct:exact_text "8.   TERMINATION" ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 13190 .

ex:C099P0090 a ct:SourcePassage ;
    ct:end_char 13305 ;
    ct:exact_text "8.1  XFN may terminate this Agreement by giving thirty (30) days written notice      to the CEIS." ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 13208 .

ex:C099P0091 a ct:SourcePassage ;
    ct:end_char 13354 ;
    ct:exact_text "8.2  Either Party may terminate this Agreement:" ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 13307 .

ex:C099P0095 a ct:SourcePassage ;
    ct:end_char 13841 ;
    ct:exact_text "8.3  Upon termination of the Agreement:" ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 13802 .

ex:C099P0096 a ct:SourcePassage ;
    ct:end_char 13942 ;
    ct:exact_text "(a)  CEIS shall terminate the transmission of the Content with immediate           effect; and" ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 13848 .

ex:C099P0097 a ct:SourcePassage ;
    ct:end_char 14245 ;
    ct:exact_text "(b)  in the event that this Agreement is terminated prior to the expiry of           the Term, XFN shall recover any sums paid to CEIS in advance for the           unexpired Term of this Agreement, together with interest from the date           those sums were paid until the date of full refund." ;
    ct:source_path "cuad/XinhuaSportsEntertainmentLtd_20070221_F-1_EX-99.4_645553_EX-99.4_Content License Agreement.txt" ;
    ct:source_sha256 "d20ca7099b4894b290f3e0399f466b78ab1cd297bdfc9b270b80528607dcab51" ;
    ct:start_char 13949 .

