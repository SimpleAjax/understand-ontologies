ex:C002R0012Condition175 a ct:Condition ;
    ct:description "shall not be approved by AIRSOPURE, Your executor, administrator or personal representative shall transfer Your interest to a third Party approved by AIRSOPURE within 6 months after Your death or the determination of Your mental incapacity. If Your interest is not disposed of within 6 months after such death or mental incapacity, AIRSOPURE may terminate this Agreement." ;
    ct:supported_by ex:C002P0175 ;
    meta:review_status "UNREVIEWED" .

