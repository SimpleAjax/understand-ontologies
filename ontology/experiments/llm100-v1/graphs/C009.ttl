    rdfs:label "Conditional Referenced Term — source passage 15" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:references_section ex:C009R0003Ref0 ;
    ct:subject_to ex:C009R0003Condition15 ;
    ct:supported_by ex:C009P0015 ;
    meta:review_status "UNREVIEWED" .

