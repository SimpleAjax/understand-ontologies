    ct:start_char 32898 .

ex:C031P0076 a ct:SourcePassage ;
    ct:end_char 61471 ;
    ct:exact_text "(i) If DIALOG is acquired by a third party, DIALOG's acquirer will have the right, for a period of [***] following closing of such acquisition, to terminate this Agreement upon written notice to ENERGOUS.   * Confidential Treatment Requested" ;
    ct:source_path "cuad/ENERGOUSCORP_03_16_2017-EX-10.24-STRATEGIC ALLIANCE AGREEMENT.txt" ;
    ct:source_sha256 "d2dcc7fa33b3143ae561025ba2e907e4c3d36a7ee3782f8b3d35744c7642a0f9" ;
