    ct:start_char 10481 .

ex:C058P0102 a ct:SourcePassage ;
    ct:end_char 31063 ;
    ct:exact_text "A.       TERM. This Agreement will be in effect for one year from the Effective Date and will automatically renew for successive one (1) year periods unless terminated as provided below." ;
    ct:source_path "cuad/NETGEAR,INC_04_21_2003-EX-10.16-DISTRIBUTOR AGREEMENT.txt" ;
    ct:source_sha256 "1b4a0744754138176a7a3081a9c89a859248df2013a56f6ef13eeccbc264c9a1" ;
    ct:start_char 30877 .

