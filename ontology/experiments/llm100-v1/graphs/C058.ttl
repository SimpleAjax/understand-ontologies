    ct:references_section ex:C058R0002Ref0 ;
    ct:supported_by ex:C058P0017 ;
    meta:review_status "UNREVIEWED" .

ex:C058R0002Ref0 a ct:Reference ;
    rdfs:label "Exhibit 4" ;
    ct:resolution_status "UNRESOLVED" .

ex:C058R0003 a ct:Rule ;
    rdfs:label "Initial Term — source passage 18" ;
    ct:kind "INITIAL_TERM" ;
    ct:subject_to ex:C058R0003Condition18 ;
    ct:supported_by ex:C058P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C058R0003Condition18 a ct:Condition ;
    ct:description "NETGEAR reserves the right to sell or license Products in the Territory to customers other than distributors such as, but not limited to resellers who procure Products at centralized locations for resale to end-use customers solely through their wholly or majority owned retail outlets, both store-front and catalog. Following the initial one (1) year term, for any extension or renewal term, Distributor's appointment as Distributor shall be non-exclusive and NETGEAR may appoint other distributors in the Territory at its sole discretion." ;
    ct:supported_by ex:C058P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C058R0004 a ct:Rule ;
    rdfs:label "Optional Renewal — source passage 18" ;
    ct:kind "OPTIONAL_RENEWAL" ;
    ct:subject_to ex:C058R0004Condition18 ;
    ct:supported_by ex:C058P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C058R0004Condition18 a ct:Condition ;
    ct:description "NETGEAR reserves the right to sell or license Products in the Territory to customers other than distributors such as, but not limited to resellers who procure Products at centralized locations for resale to end-use customers solely through their wholly or majority owned retail outlets, both store-front and catalog. Following the initial one (1) year term, for any extension or renewal term, Distributor's appointment as Distributor shall be non-exclusive and NETGEAR may appoint other distributors in the Territory at its sole discretion." ;
    ct:supported_by ex:C058P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C058R0005 a ct:Rule ;
    rdfs:label "Termination — source passage 43" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C058R0005Condition43 ;
    ct:supported_by ex:C058P0043 ;
    meta:review_status "UNREVIEWED" .

ex:C058R0005Condition43 a ct:Condition ;
    ct:description "service charge provided NETGEAR has provided 10 days written notice to Distributor of Distributor's failure to pay. The foregoing notwithstanding, Distributor shall not be deemed in default under this provision if Distributor withholds payment of amounts legitimately in dispute on any invoice provided that (1) Distributor promptly pays the undisputed portion of the invoice in accordance with the terms of this Agreement; (2) Distributor provides NETGEAR with written notice of the disputed amount within 10 days of receipt of the invoice; and (3) Distributor works in good faith with NETGEAR to resolve any dispute within a reasonable time period." ;
    ct:supported_by ex:C058P0043 ;
    meta:review_status "UNREVIEWED" .

