ex:C090P0075 a ct:SourcePassage ;
    ct:end_char 34766 ;
    ct:exact_text "c)       All undisputed payments that have accrued prior to                           the termination or expiration of this Agreement will                           be payable in full within thirty (30) days thereof." ;
    ct:source_path "cuad/VITAMINSHOPPECOMINC_09_13_1999-EX-10.26-SPONSORSHIP AGREEMENT.txt" ;
    ct:source_sha256 "0df2116cdf74ca2842b3ae8fe77864e2bb350d05d9dc1d967485a95833402ad5" ;
    ct:start_char 34550 .

ex:C090P0076 a ct:SourcePassage ;
    ct:end_char 35115 ;
    ct:exact_text "d)       The provisions of Section 12 (Confidentiality and                           User Data), Section 13 (Indemnity), Section 14                           (Limitation of Liability) and Section 15 (Dispute                           Resolution) will survive any termination or                           expiration of this Agreement." ;
    ct:source_path "cuad/VITAMINSHOPPECOMINC_09_13_1999-EX-10.26-SPONSORSHIP AGREEMENT.txt" ;
    ct:source_sha256 "0df2116cdf74ca2842b3ae8fe77864e2bb350d05d9dc1d967485a95833402ad5" ;
    ct:start_char 34782 .

ex:C090P0078 a ct:SourcePassage ;
    ct:end_char 37108 ;
    ct:exact_text "Client's termination of the Agreement in                           accordance with the previous sentence will not                           relieve Excite of its obligation to deliver any                           previously paid for but undelivered impressions.  If                           Excite achieves the annual impression delivery goal                           at any time during the Make-Good Period, the term of                           this Agreement will continue and Client shall                           immediately resume payment of the sponsorship and                           advertising fees specified in Section 7." ;
    ct:source_path "cuad/VITAMINSHOPPECOMINC_09_13_1999-EX-10.26-SPONSORSHIP AGREEMENT.txt" ;
    ct:source_sha256 "0df2116cdf74ca2842b3ae8fe77864e2bb350d05d9dc1d967485a95833402ad5" ;
    ct:start_char 36470 .

ex:C090P0084 a ct:SourcePassage ;
    ct:end_char 38885 ;
    ct:exact_text "d)       Upon the expiration or termination of this Agreement,                           each party will cease using the trademarks, service                           marks and/or trade names of the other except:" ;
    ct:source_path "cuad/VITAMINSHOPPECOMINC_09_13_1999-EX-10.26-SPONSORSHIP AGREEMENT.txt" ;
    ct:source_sha256 "0df2116cdf74ca2842b3ae8fe77864e2bb350d05d9dc1d967485a95833402ad5" ;
    ct:start_char 38673 .

ex:C090R0001 a ct:Rule ;
    rdfs:label "Termination — source passage 34" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C090R0001Condition34 ;
    ct:supported_by ex:C090P0034 ;
    meta:review_status "UNREVIEWED" .

ex:C090R0001Condition34 a ct:Condition ;
    ct:description "If the privacy                           policy changes in a manner that has a material                           adverse effect on the value, functionality or                           implementation of the DeliverE message campaign for                           Client, Excite will notify Client, which will then                           have the option to cancel future DeliverE campaigns                           and both parties will be relieved of their                           obligations related to those canceled DeliverE                           campaigns, if Client, in its sole but reasonable                           discretion, finds such changed privacy policy                           objectionable." ;
    ct:supported_by ex:C090P0034 ;
    meta:review_status "UNREVIEWED" .

ex:C090R0002 a ct:Rule ;
    rdfs:label "Initial Term — source passage 73" ;
    ct:kind "INITIAL_TERM" ;
    ct:references_section ex:C090R0002Ref0 ;
    ct:subject_to ex:C090R0002Condition73 ;
    ct:supported_by ex:C090P0073 ;
    meta:review_status "UNREVIEWED" .

ex:C090R0002Condition73 a ct:Condition ;
    ct:description "a)       Unless terminated earlier in accordance with the                           specific terms of this Agreement, the term of this                           Agreement will begin on the Launch Date and will not                           end until Excite displays a total of [*****]                           impressions of the Client advertising banners and                           promotional placements on the Excite Network as                           described in this Agreement and pushes [*****]                           emails using the email vehicles specified in Exhibit                           B.  Regardless of Excite's actual delivery of                           impressions, the term of this Agreement will not be                           shorter than [*****]  after the Launch Date,                           unless the Agreement is terminated earlier in                           accordance with the specific terms of this Agreement." ;
    ct:supported_by ex:C090P0073 ;
    meta:review_status "UNREVIEWED" .

ex:C090R0002Ref0 a ct:Reference ;
    rdfs:label "Exhibit                           B" ;
    ct:resolution_status "UNRESOLVED" .

