    rdfs:label "Conditional Referenced Term — source passage 73" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:references_section ex:C090R0003Ref0 ;
    ct:subject_to ex:C090R0003Condition73 ;
    ct:supported_by ex:C090P0073 ;
    meta:review_status "UNREVIEWED" .

