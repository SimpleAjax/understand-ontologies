    rdfs:label "Termination — source passage 77" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C090R0008Ref0,
        ex:C090R0008Ref1 ;
    ct:subject_to ex:C090R0008Condition77 ;
    ct:supported_by ex:C090P0077 ;
