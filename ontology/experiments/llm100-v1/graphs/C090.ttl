ex:C090R0004Condition74 a ct:Condition ;
    ct:description "b)       Either party may terminate this Agreement if the                           other party materially breaches its obligations                           hereunder and such breach remains uncured for thirty                           (30) days following the notice to the breaching party                           of the breach." ;
    ct:supported_by ex:C090P0074 ;
    meta:review_status "UNREVIEWED" .

