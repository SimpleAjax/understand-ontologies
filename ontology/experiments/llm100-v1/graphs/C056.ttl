        ex:C056R0008 ;
    ct:source_path "cuad/MphaseTechnologiesInc_20030911_10-K_EX-10.15_1560667_EX-10.15_Co-Branding Agreement.txt" ;
    ct:source_sha256 "c00e73fa23804a8ea70f011dfaca0debf75bccdeb375ca864cbf2a36a0ff4ce8" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C056P0008 a ct:SourcePassage ;
    ct:end_char 1878 ;
    ct:exact_text "3.       In the event that mPhase's use of the Lucent Co-Branding Logo, in the          sole judgment of Lucent, may adversely affect Lucent's rights to the          mark shown on Schedule A or the marks and names LUCENT, LUCENT          TECHNOLOGIES or LUCENT INNOVATION RING DESIGN, Lucent may upon written          notification to mPhase, terminate this Agreement." ;
    ct:source_path "cuad/MphaseTechnologiesInc_20030911_10-K_EX-10.15_1560667_EX-10.15_Co-Branding Agreement.txt" ;
    ct:source_sha256 "c00e73fa23804a8ea70f011dfaca0debf75bccdeb375ca864cbf2a36a0ff4ce8" ;
    ct:start_char 1511 .

ex:C056P0019 a ct:SourcePassage ;
    ct:end_char 5028 ;
    ct:exact_text "12.      Upon termination of this Agreement, mPhase shall immediately cease use          of the Lucent Co-Branding Logo, provided, however, that mPhase shall          have no obligation to remove such Co-Branding Logo from any Goods sold          prior to the date of such termination." ;
    ct:source_path "cuad/MphaseTechnologiesInc_20030911_10-K_EX-10.15_1560667_EX-10.15_Co-Branding Agreement.txt" ;
    ct:source_sha256 "c00e73fa23804a8ea70f011dfaca0debf75bccdeb375ca864cbf2a36a0ff4ce8" ;
    ct:start_char 4743 .

ex:C056R0001 a ct:Rule ;
    rdfs:label "Termination — source passage 8" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C056R0001Ref0 ;
    ct:supported_by ex:C056P0008 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0001Ref0 a ct:Reference ;
    rdfs:label "Schedule A" ;
    ct:resolution_status "UNRESOLVED" .

ex:C056R0002 a ct:Rule ;
    rdfs:label "Termination — source passage 10" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C056R0002Condition10 ;
    ct:supported_by ex:C056P0010 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0002Condition10 a ct:Condition ;
    ct:description "5.       mPhase agrees not to adopt any designation which is confusingly similar          to the Lucent Co-Branding Logo or Lucent's marks LUCENT, LUCENT          TECHNOLOGIES or LUCENT INNOVATION RING DESIGN. Any attempt to do so          shall be a breach of this Agreement and Lucent may terminate this          Agreement without notice in the event of such a breach." ;
    ct:supported_by ex:C056P0010 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0003 a ct:Rule ;
    rdfs:label "Termination — source passage 11" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C056R0003Condition11 ;
    ct:supported_by ex:C056P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0003Condition11 a ct:Condition ;
    ct:description "6.       This Agreement shall terminate in the event of a significant change in          the management or ownership of mPhase or in the event mPhase is the          subject of any bankruptcy proceedings." ;
    ct:supported_by ex:C056P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0004 a ct:Rule ;
    rdfs:label "Termination — source passage 13" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C056R0004Condition13 ;
    ct:supported_by ex:C056P0013 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0004Condition13 a ct:Condition ;
    ct:description "8.       If Lucent determines that mPhase's Goods are no longer maintained at          the current level of quality, Lucent shall so notify mPhase, in          writing, and Lucent shall have the right to terminate this Agreement." ;
    ct:supported_by ex:C056P0013 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0005 a ct:Rule ;
    rdfs:label "Initial Term — source passage 18" ;
    ct:kind "INITIAL_TERM" ;
    ct:subject_to ex:C056R0005Condition18 ;
    ct:supported_by ex:C056P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0005Condition18 a ct:Condition ;
    ct:description "11.      The Term of this Agreement will commence on the date above, and shall          continue for a term of one (1) year. mPhase shall have the right to          annually renew this agreement for a period of one year upon each annual          expiration with the written consent of Lucent, which written consent          shall not be unreasonably withheld. Either party wishing to terminate          the Agreement must give written notice to the other party at least          thirty (30) days prior to the desired date of termination." ;
    ct:supported_by ex:C056P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0006 a ct:Rule ;
    rdfs:label "Optional Renewal — source passage 18" ;
    ct:kind "OPTIONAL_RENEWAL" ;
    ct:subject_to ex:C056R0006Condition18 ;
    ct:supported_by ex:C056P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0006Condition18 a ct:Condition ;
    ct:description "11.      The Term of this Agreement will commence on the date above, and shall          continue for a term of one (1) year. mPhase shall have the right to          annually renew this agreement for a period of one year upon each annual          expiration with the written consent of Lucent, which written consent          shall not be unreasonably withheld. Either party wishing to terminate          the Agreement must give written notice to the other party at least          thirty (30) days prior to the desired date of termination." ;
    ct:supported_by ex:C056P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C056R0007 a ct:Rule ;
    rdfs:label "Termination — source passage 18" ;
    ct:kind "TERMINATION" ;
