ex:C056 a ct:Agreement ;
    rdfs:label "MphaseTechnologiesInc_20030911_10-K_EX-10.15_1560667_EX-10.15_Co-Branding Agreement.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C056R0001,
        ex:C056R0002,
        ex:C056R0003,
        ex:C056R0004,
        ex:C056R0005,
        ex:C056R0006,
