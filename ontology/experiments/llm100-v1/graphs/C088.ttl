ex:C088R0008Condition43 a ct:Condition ;
    ct:description "5.01     TERM.  The  term  (\"Term\")  of  this Agreement shall be for one hundred eighty  days  (180)  from  the  date set forth below unless Network 1 or Visa or MasterCard  or Harris Bank doesn't approve Affiliate's ISO application, in which case,  the  Term  will  be  3 years. This Agreement will automatically renew for successive  one-year  terms  unless  terminated by either party by providing the other  with  30  days  written notice that this Agreement will not be renewed or Affiliate  enters  into  a  Processing  agreement  with  Network  1  and  an ISO Sponsorship  agreement  with  Harris  Bank  in  which  case  this Agreement will automatically  terminate  concurrent  with  the  execution  of  such agreements." ;
    ct:supported_by ex:C088P0043 ;
    meta:review_status "UNREVIEWED" .

ex:C088R0009 a ct:Rule ;
    rdfs:label "Automatic Renewal — source passage 43" ;
    ct:kind "AUTOMATIC_RENEWAL" ;
    ct:subject_to ex:C088R0009Condition43 ;
    ct:supported_by ex:C088P0043 ;
    meta:review_status "UNREVIEWED" .

ex:C088R0009Condition43 a ct:Condition ;
    ct:description "5.01     TERM.  The  term  (\"Term\")  of  this Agreement shall be for one hundred eighty  days  (180)  from  the  date set forth below unless Network 1 or Visa or MasterCard  or Harris Bank doesn't approve Affiliate's ISO application, in which case,  the  Term  will  be  3 years. This Agreement will automatically renew for successive  one-year  terms  unless  terminated by either party by providing the other  with  30  days  written notice that this Agreement will not be renewed or Affiliate  enters  into  a  Processing  agreement  with  Network  1  and  an ISO Sponsorship  agreement  with  Harris  Bank  in  which  case  this Agreement will automatically  terminate  concurrent  with  the  execution  of  such agreements." ;
    ct:supported_by ex:C088P0043 ;
    meta:review_status "UNREVIEWED" .

