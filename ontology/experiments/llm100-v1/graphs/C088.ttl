ex:C088R0004 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 25" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C088R0004Condition25 ;
