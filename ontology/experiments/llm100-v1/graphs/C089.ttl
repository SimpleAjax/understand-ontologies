    rdfs:label "Termination — source passage 52" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C089P0052 ;
    meta:review_status "UNREVIEWED" .

ex:C089R0002 a ct:Rule ;
    rdfs:label "Termination — source passage 66" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C089R0002Condition66 ;
    ct:supported_by ex:C089P0066 ;
    meta:review_status "UNREVIEWED" .

ex:C089R0002Condition66 a ct:Condition ;
    ct:description "Agreement by written notice thereof to Sutro within [***] days after such selection, the Parties shall execute the definitive Phase 3/Commercial Supply Agreement selected by the arbitrator (but excluding, for clarity, any provision granting to SutroVax or its Affiliates or Sublicensees any right to obtain or use any Sutro Core Know-How); and if SutroVax elects to not enter into the Phase 3/Commercial Supply Agreement selected by the arbitrator by providing notice thereof within such [***] day period, then neither Party shall be obligated to enter into the Phase 3/Commercial Supply Agreement." ;
    ct:supported_by ex:C089P0066 ;
    meta:review_status "UNREVIEWED" .

ex:C089R0003 a ct:Rule ;
    rdfs:label "Termination — source passage 76" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C089P0076 ;
    meta:review_status "UNREVIEWED" .

ex:C089R0004 a ct:Rule ;
    rdfs:label "Conditional Referenced Term — source passage 106" ;
    ct:kind "CONDITIONAL_REFERENCED_TERM" ;
    ct:subject_to ex:C089R0004Condition106 ;
    ct:supported_by ex:C089P0106 ;
    meta:review_status "UNREVIEWED" .

ex:C089R0004Condition106 a ct:Condition ;
    ct:description "SutroVax's failure to notify Sutro of the non-conformity within the Acceptance Period will be deemed for purposes of this Supply Agreement to constitute SutroVax's acceptance of such shipment, provided, however, that such acceptance shall be subject to SutroVax's right to reject Product(s) until [***] days from the delivery date of the applicable Product, in each case, due to discovery by SutroVax or SutroVax's Affiliates or designees that the applicable Product does not conform to the Required Standards and such non-conformance could not reasonably be discovered within the Acceptance Period (\"Latent Defects\") provided that SutroVax gives Sutro with written notice of such Latent Defect within [***] days of SutroVax or any SutroVax Affiliate or designee becoming aware of such defect." ;
    ct:supported_by ex:C089P0106 ;
    meta:review_status "UNREVIEWED" .

ex:C089R0005 a ct:Rule ;
    rdfs:label "Initial Term — source passage 169" ;
    ct:kind "INITIAL_TERM" ;
    ct:references_section ex:C089R0005Ref0 ;
    ct:supported_by ex:C089P0169 ;
    meta:review_status "UNREVIEWED" .

