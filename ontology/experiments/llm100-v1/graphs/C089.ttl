    rdfs:label "VAXCYTE,INC_05_22_2020-EX-10.19-SUPPLY AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
