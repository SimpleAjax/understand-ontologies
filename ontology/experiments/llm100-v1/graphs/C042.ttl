ex:C042P0044 a ct:SourcePassage ;
    ct:end_char 9311 ;
    ct:exact_text "3.1.  This Agreement shall commence on 1 January 1998. The initial term of             the Services, unless terminated as set out herein, shall continue up             to and including 28 February 2000 (\"the Initial Term\")." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 9088 .

ex:C042P0045 a ct:SourcePassage ;
    ct:end_char 9345 ;
    ct:exact_text "3.2.  Right of Renewal" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 9323 .

ex:C042P0046 a ct:SourcePassage ;
    ct:end_char 9471 ;
    ct:exact_text "The Publishers shall have the right to renew the term of the             Services as provided in this Agreement." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 9359 .

ex:C042P0085 a ct:SourcePassage ;
    ct:end_char 19528 ;
    ct:exact_text "10.2.3. The Publishers shall have the right to terminate the licence                     referred to in Clause 10.2.1 by giving three months' notice                     in writing to HealthGate." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 19334 .

ex:C042P0112 a ct:SourcePassage ;
    ct:end_char 25519 ;
    ct:exact_text "17.   Right of Renewal" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 25497 .

ex:C042P0115 a ct:SourcePassage ;
    ct:end_char 26606 ;
    ct:exact_text "18.   Assistance upon Termination" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 26573 .

ex:C042P0116 a ct:SourcePassage ;
    ct:end_char 26715 ;
    ct:exact_text "On termination of the provision of the Services by HealthGate to the       Publishers for any reason:" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 26614 .

ex:C042P0118 a ct:SourcePassage ;
    ct:end_char 27329 ;
    ct:exact_text "18.1. HealthGate will liaise with the Publishers, making available for             such purposes such HealthGate liaison staff as the Publishers may             reasonably require, and acting in all good faith, to ensure a             mutually satisfactory license to the Publishers or, at the             Publishers' option, to a replacement contractor. The period of             liaison will commence as soon as notice has been given of             termination of this Agreement, and will continue for a maximum             period of 3 months after termination;" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 26766 .

ex:C042P0119 a ct:SourcePassage ;
    ct:end_char 27692 ;
    ct:exact_text "18.2. HealthGate agrees that at the time of termination of this Agreement,             it will render all assistance, provide all documentation and             undertake all actions to the extent necessary to effect an orderly             assumption of the Services by the Publishers or, at the Publishers'             option, by a replacement contractor;" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 27337 .

ex:C042P0189 a ct:SourcePassage ;
    ct:end_char 46165 ;
    ct:exact_text "The parties hereto acknowledge and agree that the Publishers and/or             their licensors own and will continue to own all right, title and             interest in and to Publishers' Journals and other data, including             but not limited to usage statistics for the Services (\"Publishers'             Data\"). Upon the termination of this Agreement for any reason or,             with respect to any Publishers' Data, on such earlier date as the             Publishers shall determine that any of the same will no longer be             required by HealthGate in order to render Services to the             Publishers, Publishers' Data will be either erased from the data             files maintained by HealthGate. or if the Publishers so elect,             returned to the Publishers by HealthGate. The Publishers' Data may             not be utilized by HealthGate for any purpose except to provide             Services to the Publishers, nor may Publishers' Data or any part             thereof be disclosed, sold, assigned, leased or otherwise disposed             of to third parties by HealthGate or commercially exploited by or on             behalf of HealthGate, or any of its employees or agents." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 44946 .

ex:C042P0220 a ct:SourcePassage ;
    ct:end_char 54973 ;
    ct:exact_text "32.   Termination, Change of Control of HealthGate" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 54923 .

ex:C042P0221 a ct:SourcePassage ;
    ct:end_char 55230 ;
    ct:exact_text "32.1. Notwithstanding any provisions herein contained this Agreement may             be terminated forthwith by either party by notice in writing from             the party not at fault if any of the following events shall occur,             namely:" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 54981 .

ex:C042P0224 a ct:SourcePassage ;
    ct:end_char 56676 ;
    ct:exact_text "If any such event referred to in this sub-clause shall occur,                   termination shall become effective forthwith or on the date                   set forth in such notice." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 56493 .

ex:C042P0225 a ct:SourcePassage ;
    ct:end_char 56866 ;
    ct:exact_text "32.2.    Either party may by notice in writing to the other party                   terminate this Agreement, if any of the following events shall                   occur, namely:" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 56687 .

ex:C042P0231 a ct:SourcePassage ;
    ct:end_char 58640 ;
    ct:exact_text "32.3. Termination, howsoever or whenever occasioned shall be subject to             any rights and remedies either party may have under this Agreement             or in Law." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 58467 .

ex:C042P0232 a ct:SourcePassage ;
    ct:end_char 58821 ;
    ct:exact_text "32.4. the following Clauses shall survive termination for whatever cause             of this Agreement: Clauses 4.2, 5, 10.2, 20.4, 23.2, 25-28, 30-34             inclusive." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 58648 .

ex:C042P0233 a ct:SourcePassage ;
    ct:end_char 58852 ;
    ct:exact_text "33.   Rights Upon Termination" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 58823 .

ex:C042P0234 a ct:SourcePassage ;
    ct:end_char 59010 ;
    ct:exact_text "Upon termination of this Agreement and for a period of six (6) months       thereafter, the Publishers will have the following rights and obligations:" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 58860 .

ex:C042P0235 a ct:SourcePassage ;
    ct:end_char 59649 ;
    ct:exact_text "33.1. Commencing upon any notice of termination by the Publishers,             HealthGate will comply with the Publishers' reasonable directions,             and will provide to the Publishers any and all termination             assistance reasonably requested by the Publishers to allow the             Services to continue and to facilitate the orderly transfer of             responsibility for the Services to the Publishers or a successor             provider of Services designated by the Publishers. The termination             assistance to be provided to the Publishers by HealthGate may             include the following:" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 59018 .

ex:C042P0242 a ct:SourcePassage ;
    ct:end_char 61785 ;
    ct:exact_text "33.3. Upon receipt of written notice from the Publishers that HealthGate             is in default under this Agreement by failing to comply with the             requirements of this Clause 33, or that HealthGate is in default             under any provision regarding rights upon termination of this             Agreement, HealthGate shall have ten (10) business days in which to             cure such default. HealthGate acknowledges that, in the event             HealthGate fails to cure such default within the specified time             period, the Publishers would suffer irreparable harm, and             HealthGate, hereby agrees that the Publishers would in such event be             entitled to obtain from a court of competent jurisdiction an order             of specific performance, in addition to such other rights and             remedies to which it may be entitled at law or in equity under this             Agreement." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 60848 .

ex:C042P0243 a ct:SourcePassage ;
    ct:end_char 62418 ;
    ct:exact_text "33.4. Upon the termination of this Agreement or HealthGate's engagement             whichever shall be the earlier, HealthGate or its personal             representative as the case may be, shall immediately deliver up to             the Publishers all correspondence, reports, documents,             specifications, papers, information (on whatever media) and property             belonging to the Publishers which may be in his possession or under             his control together with all confidential information or copyright             works belonging to the Publishers specified in Clauses 27 and 31             above." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 61793 .

ex:C042P0416 a ct:SourcePassage ;
    ct:end_char 85609 ;
    ct:exact_text "4.    Account expiration: If the account expires, or reaches the monetary             cap assigned, the user will be shown a page that prompts them to             contact Blackwell/Munksgaard to renew the account. This page will             also provide the option to continue and have purchases applied to a             credit card. A report will be available warning Blackwell/Munksgaard             of accounts that are close to expiring." ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 85168 .

ex:C042P0761 a ct:SourcePassage ;
    ct:end_char 143911 ;
    ct:exact_text "o     Expiration Date" ;
    ct:source_path "cuad/HEALTHGATEDATACORP_11_24_1999-EX-10.1-HOSTING AND MANAGEMENT AGREEMENT (1).txt" ;
    ct:source_sha256 "8180c54f224250c10362b5d159032157a5d30a1821b0897f392c971a8764925a" ;
    ct:start_char 143890 .

