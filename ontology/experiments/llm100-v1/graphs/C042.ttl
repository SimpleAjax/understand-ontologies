ex:C042R0004Condition54 a ct:Condition ;
    ct:description "5.2.  If HealthGate fails to complete the System by the end of the tenth             week after the System Completion Date then the Publishers (unless             such failure demonstrably results from the Publishers' default in             the performance of its obligations under this Agreement) will be             entitled without prejudice to any other rights or remedies they may             have under this Agreement or at law or in equity to terminate this             Agreement immediately by written notice." ;
    ct:supported_by ex:C042P0054 ;
    meta:review_status "UNREVIEWED" .

