ex:C011P0011 a ct:SourcePassage ;
    ct:end_char 464 ;
    ct:exact_text "3.   EFFECTIVE DATE AND DURATION     5" ;
    ct:source_path "cuad/AzulSa_20170303_F-1A_EX-10.3_9943903_EX-10.3_Maintenance Agreement2.txt" ;
    ct:source_sha256 "2d98d5344e92fe02c4726bc483ff9f00facbfa8161d3877cd522d8f6ac4ac2a1" ;
    ct:start_char 426 .

ex:C011P0046 a ct:SourcePassage ;
    ct:end_char 4772 ;
    ct:exact_text "This Amendment shall enter into force on the date of its signature by both Parties and, unless otherwise agreed upon in writing by the Parties through a subsequent amendment to the GMA, shall remain in force for the term of the referenced GMA." ;
    ct:source_path "cuad/AzulSa_20170303_F-1A_EX-10.3_9943903_EX-10.3_Maintenance Agreement2.txt" ;
    ct:source_sha256 "2d98d5344e92fe02c4726bc483ff9f00facbfa8161d3877cd522d8f6ac4ac2a1" ;
    ct:start_char 4529 .

ex:C011P0078 a ct:SourcePassage ;
    ct:end_char 11131 ;
    ct:exact_text "4.5 For the sake of clarity, and for the purpose of this Clause 4 and this Amendment, any of the receiving Party's Affiliates and their Subcontractors shall not be considered as third party and shall be entitled to have access to any Confidential Information disclosed by the disclosing Party in connection with this Amendment.   4.6 This Clause 4 shall survive termination or expiry of this Amendment for a period of five (5) years following such End Date." ;
    ct:source_path "cuad/AzulSa_20170303_F-1A_EX-10.3_9943903_EX-10.3_Maintenance Agreement2.txt" ;
    ct:source_sha256 "2d98d5344e92fe02c4726bc483ff9f00facbfa8161d3877cd522d8f6ac4ac2a1" ;
    ct:start_char 10674 .

ex:C011R0001 a ct:Rule ;
    rdfs:label "Initial Term — source passage 11" ;
    ct:kind "INITIAL_TERM" ;
    ct:supported_by ex:C011P0011 ;
    meta:review_status "UNREVIEWED" .

ex:C011R0002 a ct:Rule ;
    rdfs:label "Initial Term — source passage 46" ;
    ct:kind "INITIAL_TERM" ;
    ct:supported_by ex:C011P0046 ;
    meta:review_status "UNREVIEWED" .

ex:C011R0003 a ct:Rule ;
    rdfs:label "Post Expiry Continuation — source passage 78" ;
    ct:kind "POST_EXPIRY_CONTINUATION" ;
    ct:references_section ex:C011R0003Ref0 ;
    ct:supported_by ex:C011P0078 ;
    meta:review_status "UNREVIEWED" .

ex:C011R0003Ref0 a ct:Reference ;
    rdfs:label "Clause 4" ;
    ct:resolution_status "UNRESOLVED" .

