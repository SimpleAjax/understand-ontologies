ex:C015R0013Condition100 a ct:Condition ;
    ct:description "11.4 You may summarily terminate your employment hereunder at any time (without notice) for Good Reason after complying with the Good Reason Process. For purposes of this Agreement, \"Good Reason\" shall mean that you have complied with the \"Good Reason Process\" (hereinafter defined) following the occurrence of any of the following events: (i) a material diminution in your responsibilities, authority or duties; (ii) a material diminution in your Salary; (iii) a material change in the geographic location at which you provides services to the Company; or (iv) the material breach of this Agreement by the Company. \"Good Reason Process\" shall mean that (i) you reasonably determine in good faith that a \"Good Reason\" condition has occurred; (ii) you notify the Company in writing of the first occurrence of the Good" ;
    ct:supported_by ex:C015P0100 ;
    meta:review_status "UNREVIEWED" .

ex:C015R0014 a ct:Rule ;
    rdfs:label "Termination — source passage 102" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C015R0014Condition102 ;
    ct:supported_by ex:C015P0102 ;
    meta:review_status "UNREVIEWED" .

ex:C015R0014Condition102 a ct:Condition ;
    ct:description "Reason condition within 60 days of the first occurrence of such condition; (iii) you cooperate in good faith with the Company's efforts, for a period not less than 30 days following such notice (the \"Cure Period\"), to remedy the condition; (iv) notwithstanding such efforts, the Good Reason condition continues to exist; and (v) you terminate your employment (without notice) within 60 days after the end of the Cure Period. If the Company cures the Good Reason condition during the Cure Period, Good Reason shall be deemed not to have occurred." ;
    ct:supported_by ex:C015P0102 ;
    meta:review_status "UNREVIEWED" .

