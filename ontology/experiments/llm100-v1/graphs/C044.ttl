ex:C044 a ct:Agreement ;
    rdfs:label "HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:coverage "LOCAL_LLM_PROPOSED_PARTIAL; NOT_HUMAN_REVIEWED" ;
    ct:has_rule ex:C044R0001,
        ex:C044R0002,
        ex:C044R0003,
        ex:C044R0004,
        ex:C044R0005,
        ex:C044R0006,
        ex:C044R0007 ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    meta:model_digest "0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0" .

ct:Party a owl:Class ;
    rdfs:label "Party" .

ex:C044P0017 a ct:SourcePassage ;
    ct:end_char 5102 ;
    ct:exact_text "A. Unless otherwise provided for in this Agreement, the term of this Agreement shall be three years, commencing on the date of this Agreement and expiring on the third anniversary date of this Agreement (the \"Termination" ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    ct:start_char 4882 .

ex:C044P0021 a ct:SourcePassage ;
    ct:end_char 5860 ;
    ct:exact_text "C. Either Party may terminate this Agreement immediately following written notice to the other Party if the other Party:" ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    ct:start_char 5740 .

ex:C044P0025 a ct:SourcePassage ;
    ct:end_char 6726 ;
    ct:exact_text "D. Notwithstanding any termination of this Agreement for any reason, AGI has earned and shall be entitled to retain all royalties paid prior to termination and, in addition AGI shall be entitled to payment from the Company of all compensation and unreimbursed expenses, if any, outstanding as of the date of termination." ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    ct:start_char 6406 .

ex:C044P0046 a ct:SourcePassage ;
    ct:end_char 13587 ;
    ct:exact_text "19. No Implied Waivers. This Agreement may be amended, modified, superseded, cancelled, renewed or extended, and the terms and conditions hereof may be waived, only by a written instrument signed by the Parties or, in the case of a waiver, by the Party waiving compliance. No delay on the part of any Party in exercising any right, power or privilege hereunder shall operate as a waiver thereof, nor shall any waiver on the part of any Party of any right, power or privilege hereunder, nor any single or partial exercise of any right, power or privilege hereunder, preclude any other or further exercise thereof or the exercise of any other right, power or privilege hereunder." ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    ct:start_char 12910 .

ex:C044R0001 a ct:Rule ;
    rdfs:label "Initial Term — source passage 17" ;
    ct:kind "INITIAL_TERM" ;
    ct:supported_by ex:C044P0017 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0002 a ct:Rule ;
    rdfs:label "Termination — source passage 18" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C044R0002Ref0 ;
    ct:subject_to ex:C044R0002Condition18 ;
    ct:supported_by ex:C044P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0002Condition18 a ct:Condition ;
    ct:description "Date\"). In the event that the Company desires to terminate the Agreement prior to the Termination Date, it shall provide AGI with at least 60 days prior written notice of its intention to terminate this Agreement and this Agreement shall so terminate following the expiration of this 60-day period, without any further responsibility by either Party except as provided in Section 5." ;
    ct:supported_by ex:C044P0018 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0002Ref0 a ct:Reference ;
    rdfs:label "Section 5" ;
    ct:resolution_status "UNRESOLVED" .

ex:C044R0003 a ct:Rule ;
    rdfs:label "Termination — source passage 19" ;
    ct:kind "TERMINATION" ;
    ct:subject_to ex:C044R0003Condition19 ;
    ct:supported_by ex:C044P0019 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0003Condition19 a ct:Condition ;
    ct:description "B. Either Party may terminate this Agreement at any time in the event of a material breach by the other Party which remains uncured after thirty days written notice thereof." ;
    ct:supported_by ex:C044P0019 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0004 a ct:Rule ;
    rdfs:label "Termination — source passage 21" ;
    ct:kind "TERMINATION" ;
    ct:supported_by ex:C044P0021 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0005 a ct:Rule ;
    rdfs:label "Post Expiry Continuation — source passage 25" ;
    ct:kind "POST_EXPIRY_CONTINUATION" ;
    ct:supported_by ex:C044P0025 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0006 a ct:Rule ;
    rdfs:label "Termination — source passage 32" ;
    ct:kind "TERMINATION" ;
    ct:references_section ex:C044R0006Ref0 ;
    ct:subject_to ex:C044R0006Condition32 ;
    ct:supported_by ex:C044P0032 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0006Condition32 a ct:Condition ;
    ct:description "In the event of a breach of this Agreement by the Company, the Endorsement may be withdrawn by AGI in its sole discretion and this Agreement terminated pursuant to the terms of Section 3B. In the event of such withdrawal, the Company agrees forthwith to take such action as AGI may request to publicly evidence that the Endorsement has been withdrawn and the Company agrees not to hold the Business out as having the Endorsement." ;
    ct:supported_by ex:C044P0032 ;
    meta:review_status "UNREVIEWED" .

ex:C044R0006Ref0 a ct:Reference ;
    rdfs:label "Section 3" ;
    ct:resolution_status "UNRESOLVED" .

ex:C044R0007 a ct:Rule ;
    rdfs:label "Optional Renewal — source passage 46" ;
    ct:kind "OPTIONAL_RENEWAL" ;
    ct:supported_by ex:C044P0046 ;
    meta:review_status "UNREVIEWED" .

ex:C044P0018 a ct:SourcePassage ;
    ct:end_char 5490 ;
    ct:exact_text "Date\"). In the event that the Company desires to terminate the Agreement prior to the Termination Date, it shall provide AGI with at least 60 days prior written notice of its intention to terminate this Agreement and this Agreement shall so terminate following the expiration of this 60-day period, without any further responsibility by either Party except as provided in Section 5." ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    ct:start_char 5108 .

ex:C044P0019 a ct:SourcePassage ;
    ct:end_char 5680 ;
    ct:exact_text "B. Either Party may terminate this Agreement at any time in the event of a material breach by the other Party which remains uncured after thirty days written notice thereof." ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
    ct:source_sha256 "b70b1cfadd3e44ef43c5e6c08f908430c18e88b720f9967acde3299f7e71ea42" ;
    ct:start_char 5507 .

ex:C044P0032 a ct:SourcePassage ;
    ct:end_char 9542 ;
    ct:exact_text "In the event of a breach of this Agreement by the Company, the Endorsement may be withdrawn by AGI in its sole discretion and this Agreement terminated pursuant to the terms of Section 3B. In the event of such withdrawal, the Company agrees forthwith to take such action as AGI may request to publicly evidence that the Endorsement has been withdrawn and the Company agrees not to hold the Business out as having the Endorsement." ;
    ct:source_path "cuad/HOLIDAYRVSUPERSTORESINC_04_15_2002-EX-10.13-ENDORSEMENT AGREEMENT.txt" ;
