ex:C046R0017Condition56 a ct:Condition ;
    ct:description "8.4 In the event that Hydron terminates this Agreement pursuant to the provisions of Section 8.1(b), then the fees paid, if any, for the balance of the term of this Agreement shall be immediately refunded to Hydron provided Hydron has not received sponsorship rights or benefits equal to such fees." ;
    ct:supported_by ex:C046P0056 ;
    meta:review_status "UNREVIEWED" .

