ex:C046R0009Condition33 a ct:Condition ;
    ct:description "5.4 If any rule or regulation of the Stadium, or any Governing League Policy as described in Sections 5.1, 5.2 or 5.3 requires the termination or revision of any Sponsorship Right, such Sponsorship Right shall be revised or terminated upon written notice to Hydron and the provisions of Section 8.2 shall apply to such termination or revisions." ;
    ct:supported_by ex:C046P0033 ;
    meta:review_status "UNREVIEWED" .

ex:C046R0009Ref0 a ct:Reference ;
    rdfs:label "Section 8.2" ;
    ct:resolution_status "UNRESOLVED" .

