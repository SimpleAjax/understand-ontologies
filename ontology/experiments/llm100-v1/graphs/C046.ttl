ex:C046P0012 a ct:SourcePassage ;
    ct:end_char 3435 ;
    ct:exact_text "termination in whole or in part at any time upon written notice to Hydron if such Sponsorship Rights conflict with any exclusive advertising rights granted by NFL Properties, Inc. to one of its advertisers or sponsors. In the event of any such termination of exclusivity, the non-terminated Sponsorship Rights granted to Hydron by the Dolphins shall nonetheless continue for the remainder of the Term and the provisions of Section 8.2 shall apply. As of the date hereof, the Dolphins have no knowledge of any claim by NFL Properties that the Sponsorship Rights violate or conflict with exclusive rights granted by NFL Properties." ;
    ct:source_path "cuad/HYDRONTECHNOLOGIESINC_03_31_1997-EX-10.47-SPONSORSHIP AGREEMENT.txt" ;
    ct:source_sha256 "22ec07c8d251ab90a989794c5325cdd87969adc3e44df5a4df033f4ae1ea6ad3" ;
    ct:start_char 2806 .

