ex:C046R0001 a ct:Rule ;
    rdfs:label "Initial Term — source passage 6" ;
    ct:kind "INITIAL_TERM" ;
    ct:subject_to ex:C046R0001Condition6 ;
    ct:supported_by ex:C046P0006 ;
    meta:review_status "UNREVIEWED" .

ex:C046R0001Condition6 a ct:Condition ;
    ct:description "1.1 The term of this Agreement shall commence on the date hereof and terminate upon the conclusion of the week following the conclusion of the Dolphins 2000 regular season or post season, if applicable (the \"Term\" or \"Initial Term\"). However, this Agreement may be earlier terminated in accordance with the provisions hereof." ;
    ct:supported_by ex:C046P0006 ;
    meta:review_status "UNREVIEWED" .

