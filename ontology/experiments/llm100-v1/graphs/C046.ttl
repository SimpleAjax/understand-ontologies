ex:C046P0046 a ct:SourcePassage ;
    ct:end_char 15340 ;
    ct:exact_text "Each of the parties agree that the foregoing indemnities also apply for the benefit of the NFL (and its affiliates), South Florida Stadium Corporation, the owner and operator of Pro Player Stadium and their respective officials, officers, partners, agents and employees, who shall be deemed third party beneficiaries of this Agreement for the purpose of enforcing these indemnity obligations. These indemnity obligations shall survive the termination or expiration of this Agreement." ;
    ct:source_path "cuad/HYDRONTECHNOLOGIESINC_03_31_1997-EX-10.47-SPONSORSHIP AGREEMENT.txt" ;
    ct:source_sha256 "22ec07c8d251ab90a989794c5325cdd87969adc3e44df5a4df033f4ae1ea6ad3" ;
