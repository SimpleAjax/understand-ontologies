ex:C030P0084 a ct:SourcePassage ;
    ct:end_char 9645 ;
    ct:exact_text "The initial term of the contracted agreement is 5 years from the commencement date. The BSP then have the option to renew the agreement for another 5 years subject to any restructuring of the agreement as required by the parties." ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
