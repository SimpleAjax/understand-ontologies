ex:C030P0039 a ct:SourcePassage ;
    ct:end_char 3054 ;
    ct:exact_text "(iii) Datec commits a breach which at common law would justify termination of this agreement, or" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 2958 .

ex:C030P0059 a ct:SourcePassage ;
    ct:end_char 6351 ;
    ct:exact_text "Termination   14.1   Termination By BSP for Cause   33 14.2   Termination For Change Of Control   33 14.3   Termination By BSP For Convenience   34 14.4   Termination By Datec For Convenience   34 14.5   Termination Fee   34 14.6   Sole Remedy   34 14.7   Mitigation   34" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 6080 .

ex:C030P0083 a ct:SourcePassage ;
    ct:end_char 9414 ;
    ct:exact_text "The commencement date for this contract will be 16th June 2004." ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 9351 .

ex:C030P0085 a ct:SourcePassage ;
    ct:end_char 9795 ;
    ct:exact_text "Either party may advise the other of the impending expiry of the then current term, generally in accordance with section 14 .   1.5 Hours of Support" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 9647 .

ex:C030P0186 a ct:SourcePassage ;
    ct:end_char 23044 ;
    ct:exact_text "(g) ensure BSP is aware of all needs to promptly disconnect and end Network Services and remove related Equipment no longer needed by BSP upon termination of Services at a Site. Datec agrees to remove the applicable Equipment.   2.11 Performance Management" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 22788 .

ex:C030P0383 a ct:SourcePassage ;
    ct:end_char 44541 ;
    ct:exact_text "ii. in any other case, after receipt of that notice, Datec will have 48 hours in which to investigate the matters stated in the notice, discuss its findings with the BSP and resolve any problems with the person. If, following that period the BSP requests replacement of the person, Datec must replace that person, within 60 days with another person of suitable ability and qualifications.   5.3 No Right To Require Termination" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 44115 .

ex:C030P0475 a ct:SourcePassage ;
    ct:end_char 55341 ;
    ct:exact_text "Termination" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 55330 .

ex:C030P0476 a ct:SourcePassage ;
    ct:end_char 55376 ;
    ct:exact_text "14.1 Termination By BSP for Cause" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 55343 .

ex:C030P0478 a ct:SourcePassage ;
    ct:end_char 55624 ;
    ct:exact_text "(a) Datec materially breaches the agreement and the breach (\"Material Breach\") cannot be, or is not, rectified within 30 days after a notice from the BSP," ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 55470 .

ex:C030P0480 a ct:SourcePassage ;
    ct:end_char 55804 ;
    ct:exact_text "(c) any other event specified in this agreement as giving rise to a right for the BSP to terminate immediately occurs; or" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 55683 .

ex:C030P0481 a ct:SourcePassage ;
    ct:end_char 55931 ;
    ct:exact_text "(d) Datec commits a series of breaches that together constitute a Material Breach.   14.2 Termination For Change Of Control" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 55808 .

ex:C030P0489 a ct:SourcePassage ;
    ct:end_char 56957 ;
    ct:exact_text "then the BSP will pay Datec according to Section 14 - \"Termination\" of this agreement and the Termination Table in Schedule C.   14.3 Termination By BSP For Convenience" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 56789 .

ex:C030P0496 a ct:SourcePassage ;
    ct:end_char 57959 ;
    ct:exact_text "ii. terminate contractors in accordance with the terms of their contracts so as to avoid any liability to pay compensation for early termination; and" ;
    ct:source_path "cuad/ELANDIAINTERNATIONALINC_04_25_2007-EX-10.21-Outsourcing Agreement.txt" ;
    ct:source_sha256 "075b9d019d07ddbbfd78217079091a821af5277697cc22e7c797948ecf9c99c1" ;
    ct:start_char 57810 .

