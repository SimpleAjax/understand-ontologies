    d:clauseNumber 9 ;
    d:endChar 3627 ;
    d:exactText "9. Principal will grant Distributor a discount based on the Products and Prices. The proposed discount is expected to be ¨%. Discount may vary depending on product volume ordered or promotions. " ;
    d:sourceDocument ex:Document ;
    d:startChar 3433 .

