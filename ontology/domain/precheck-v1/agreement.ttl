    rdfs:label "Clause 15" ;
    d:clauseNumber 15 ;
    d:endChar 5175 ;
    d:exactText "15. This Agreement shall not be assigned by the Distributor without the prior written consent of the Principal. " ;
    d:sourceDocument ex:Document ;
    d:startChar 5063 .

ex:Clause16 a d:Clause ;
    rdfs:label "Clause 16" ;
    d:clauseNumber 16 ;
    d:endChar 5305 ;
    d:exactText "16. Official communication from Distributor or the Principal shall be in written form or by email, acknowledged by the recipient. " ;
    d:sourceDocument ex:Document ;
    d:startChar 5175 .

ex:Clause17 a d:Clause ;
    rdfs:label "Clause 17" ;
    d:clauseNumber 17 ;
    d:endChar 5460 ;
    d:exactText "17. This Agreement shall be construed in accordance with and governed by the laws of the State of Texas without regard to principles of conflicts of laws. " ;
    d:sourceDocument ex:Document ;
    d:startChar 5305 .

