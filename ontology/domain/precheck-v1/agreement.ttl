    rdfs:label "Either party independently" ;
    d:member ex:CoDiagnostics,
        ex:PreCheck ;
    d:selectionMode "ANY_ONE" ;
    d:withinAgreement ex:Agreement .

ex:Territory a d:TerritoryScope ;
    rdfs:label "Contract territory; initially Romania" ;
    d:initialPlace ex:Romania ;
    d:supportedBy ex:Clause2 .

